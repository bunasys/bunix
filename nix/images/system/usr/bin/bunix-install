#!/usr/bin/bash
# bunix-install: install bunix from a system running in memory onto a
# disk, next to what is already on it (macOS, say), into one of
#
#   - a stretch of free space (make it first: this tool does not resize
#     file systems)
#   - an existing partition, which it deletes
#   - an earlier bunix or another Linux system, whose partitions it deletes
#     (a guess from the partition table, shown in full before anything is
#     deleted)
#   - a whole disk, which it erases
#
#   bunix-install <directory>
#
# The directory has the files of one version, as they are published and
# as images/update.nix makes them: the three images of a /usr slot and
# the kernel image.  (x86's live image has them on the medium it was
# started from; nothing here is started from one yet.)
#
# After files/rootfs/usr/bin/bunix-install, x86's, which docs/install.md
# describes.  What is not as there:
#
#   - The kernel images go on the ESP, as on the disk of images/disk.nix,
#     where it has room for them; on an ESP as small as Windows makes it,
#     on an XBOOTLDR partition made for them, as x86's did always.
#   - systemd-boot goes where firmware looks when it has no entry for a
#     disk, EFI/BOOT/, with no firmware boot entry: a Mac's firmware
#     (U-Boot) keeps none.  Where that place is another system's
#     (Windows'), it goes in EFI/bunix/ instead, and a firmware boot entry
#     for it is put first (efibootmgr); not on an Apple Silicon Mac, which
#     has no such entries.  Of several ESPs the person says which.
#   - On a disk with Apple's partitions nothing of Apple's is offered for
#     deletion, and the whole disk is not: a Mac does not start without
#     them, and they are not put back by installing macOS again.
#   - The ESP of an Apple Silicon Mac's own disk is also given what the
#     Mac's boot loader loads from it, before systemd-boot can start:
#     aura's second stage with U-Boot, the EFI firmware such a Mac does
#     not have.  An ESP that has another system's is refused.
#   - The machine's own firmware, where the system in memory was handed
#     some (a Mac's, for its Wi-Fi), is kept on the new root, in
#     /var/lib/vendorfw: it is in no package.
#   - The person chooses their shell, bash or fish.
#   - The desktop is an extension in the version's files
#     (desktop_<release>.<architecture>.raw, as published), not on the
#     medium; where they have none, the question is not asked.
#
# Nothing outside the chosen space, and free space right after it, is
# written, except on the disk's ESP: EFI/BOOT/ or EFI/bunix/,
# EFI/Linux/bunix_* and loader/loader.conf; aurora/stage2.bin on an Apple
# Silicon Mac's; and the firmware's boot entries named "bunix", where
# EFI/bunix/ is written.
#
# The partitions it creates in the chosen space (UAPI Discoverable
# Partitions), the /usr slots first:
#
#   ESP         only if the disk has none
#   XBOOTLDR    only if the ESP has no room for bunix's kernel images
#   /usr slot A this version: data, dm-verity hashes, signature
#   /usr slot B empty, for the next update
#   bunix-root  ext4, the rest of the space
#
# Every one of them, and none left for the first boot to make: there
# systemd-repart would make the root partition in whatever free space it
# found (usr/lib/repart.d/50-root.conf).  What it still does, at every
# boot, is grow bunix-root into free space that comes right after it: so
# the root partition is given that space here, and where a partition is
# replaced that has free space after it, bunix takes both.
#
# On the root file system it also puts the person's account, an
# administrator through run0 (wheel).  Root gets a locked password: nobody
# logs in as root, and the console asks for a login instead of opening
# root's shell.
#
# A desktop install also puts the desktop extension on the root file
# system, as an update would have put it there, and enables it: the first
# boot shows the login screen, and updates bring the extension's next
# versions.
#
# Questions are read from standard input, so a test can answer them (disk,
# place, the ESP if the disk has several, desktop or console if the files
# have the desktop, host name, name, user name, shell, password twice,
# confirmation; tools/install-test.sh):
#   printf '1\n2\n1\nsara-laptop\nSara\nsara\n2\nsecret\nsecret\nyes\n' | bunix-install files/
set -euo pipefail
# so that a failed $(ask ...) inside a function stops the script too
shopt -s inherit_errexit

# Partition sizes in MiB.  The /usr slots as images/disk.nix has them.
ESP_SIZE=1024
USR_SIZE=2048
# verity: the hash tree is 1/128 of /usr, 16 MiB at most -- twice that
USR_VERITY_SIZE=32
USR_SIGNATURE_SIZE=1
ROOT_MIN_SIZE=8192
USR_SLOT_SIZE=$((USR_SIZE + USR_VERITY_SIZE + USR_SIGNATURE_SIZE))
NEEDED_SIZE=$((2 * USR_SLOT_SIZE + ROOT_MIN_SIZE))
# An XBOOTLDR partition, where an ESP has not that much free: two kernel
# images and more, as x86's had; and what the ESP then needs free still,
# for what starts bunix (shim, systemd-boot, MokManager, bunix's
# certificate) and systemd-boot's settings
XBOOTLDR_SIZE=1024
ESP_LOADER_FREE=4
# What an ESP that is already there needs free: two kernel images, the
# one installed and an update's beside it, of about 105 MiB each;
# systemd-boot; and on a Mac what its boot loader loads, of about 14 MiB
ESP_NEEDED_FREE=256

# The architecture, as the names of a version's files say it
case $(uname -m) in
  aarch64) ARCHITECTURE=arm64 ;;
  x86_64) ARCHITECTURE=x86-64 ;;
  *) echo "bunix-install: no name known for the architecture $(uname -m)" >&2; exit 1 ;;
esac
# GPT partition types.  Those of /usr and root are this architecture's:
# systemd says which they are.
TYPE_ESP=$(systemd-id128 -u show --value esp)
TYPE_XBOOTLDR=$(systemd-id128 -u show --value xbootldr)
TYPE_USR=$(systemd-id128 -u show --value usr)
TYPE_USR_VERITY=$(systemd-id128 -u show --value usr-verity)
TYPE_USR_VERITY_SIG=$(systemd-id128 -u show --value usr-verity-sig)
TYPE_ROOT=$(systemd-id128 -u show --value root)
# Every partition type of Apple's ends so: APFS, a Mac's recovery, the
# container its firmware keeps its own state in
APPLE_TYPES='*-11aa-aa11-00306543ecac'
# The one of them only the own disk of an Apple Silicon Mac has: where
# its firmware keeps its state (iBootSystemContainer)
APPLE_SILICON_FIRMWARE_TYPE=69646961-6700-11aa-aa11-00306543ecac
# The name the kernel's command line asks for the root partition by
# (images/uki.nix)
ROOT_NAME=bunix-root

MiB=$((1024 * 1024))
WORK=/run/bunix-install

die() { echo "bunix-install: $*" >&2; exit 1; }

ask() {
  local answer
  printf '%s ' "$1" >&2
  read -r answer || die "no answer"
  printf '%s\n' "$answer"
}

# Asks for a number from 1 to $2; prints it less one, an array index
ask_number() {
  local question=$1 count=$2
  local answer
  answer=$(ask "$question [1-$count]")
  [[ "$answer" =~ ^[0-9]+$ ]] || die "not a number: $answer"
  [ "$answer" -ge 1 ] && [ "$answer" -le "$count" ] || die "no such choice: $answer"
  echo $(( answer - 1 ))
}

# A password: not echoed on a terminal, and taken as typed, spaces at its
# ends too (IFS=)
ask_secret() {
  local answer
  printf '%s ' "$1" >&2
  IFS= read -rs answer || die "no answer"
  echo >&2
  printf '%s\n' "$answer"
}

new_uuid() { cat /proc/sys/kernel/random/uuid; }

# Whether a name is among the rest of the arguments
is_one_of() {
  local name=$1; shift
  local other
  for other in "$@"; do
    [ "$other" = "$name" ] && return 0
  done
  return 1
}

# The device of the partition of $disk with this id, once the kernel has
# it.  Of that disk, and not udev's link by the id: a /usr slot's ids are
# its version's, and another disk with the same version has them too.
device_of_partuuid() {
  local found
  for _ in $(seq 50); do
    found=$(lsblk -nrpo NAME,PARTUUID "$disk" | awk -v id="$1" '$2 == id { print $1 }')
    if [ -n "$found" ]; then
      [ "$(wc -l <<< "$found")" = 1 ] || die "$disk has more than one partition with the id $1"
      echo "$found"
      return
    fi
    udevadm settle
    sleep 0.2
  done
  die "partition $1 did not appear on $disk"
}

# The dm-verity device /usr is checked through once written (below): its
# own name, as the live system's /usr is "usr"
read_back_device=bunix-install-usr
cleanup() {
  for dir in "$WORK"/esp "$WORK"/boot "$WORK"/root; do
    mountpoint -q "$dir" && umount "$dir"
  done
  # an install stopped while /usr was checked holds slot A open with it
  if [ -e /dev/mapper/$read_back_device ]; then
    /usr/lib/systemd/systemd-veritysetup detach $read_back_device 2> /dev/null
  fi
  return 0
}
trap cleanup EXIT
# and one an earlier run left, stopped where cleanup could not run
cleanup

[ "$(id -u)" = 0 ] || die "run as root"
# It is in every /usr, but installs only from a system that runs in
# memory: one whose root is not a disk's
case $(findmnt -no FSTYPE /) in
  rootfs|tmpfs) ;;
  *) die "bunix is installed already: bunix-install runs on a system started in memory" ;;
esac

# The version to install: the files a machine downloads to become it
files=${1:-}
# On the live stick (images/live.nix), mounted once the stick is found:
# a slow one may not be yet, or it was pulled out
case $files in
  /run/bunix/medium/*)
    [ -d "$files" ] || die "$files is not there: the stick's files are not mounted yet.
Is the stick still in?  What systemd says of it:  systemctl status run-bunix-medium.mount" ;;
esac
[ -n "$files" ] && [ -d "$files" ] || die "give the directory that has the files of the version to install:
bunix_<version>.$ARCHITECTURE.efi and the three of its /usr"
mkdir -p "$WORK"/esp "$WORK"/root
# The one file in $files that matches a pattern.  None, or several, and
# the directory is not one version's.
the_file() {
  local found=("$files"/$1)
  [ -e "${found[0]}" ] || die "$files has no file named $1"
  [ ${#found[@]} = 1 ] || die "$files has ${#found[@]} files named $1; a version has one"
  echo "${found[0]}"
}
uki=$(the_file "bunix_*.$ARCHITECTURE.efi")
release=$(basename "$uki" ".$ARCHITECTURE.efi")
release=${release#bunix_}
# The desktop extension of this version, if the files have it: a choice,
# not one of the files a version needs
desktop_image=$files/desktop_$release.$ARCHITECTURE.raw
# 32 hex digits as an id is written, with its dashes
as_id() {
  echo "${1:0:8}-${1:8:4}-${1:12:4}-${1:16:4}-${1:20:12}"
}
# The id in the name of one of a release's /usr files (images/update.sh
# names them so; x86's once without dashes)
uuid_in_name() {
  as_id "$(basename "$1" .raw | sed 's/.*\.//' | tr -d -)"
}
# The disk the files are on, when they are on one (walking up through any
# loop or device-mapper layers, as on a Ventoy stick): not one to offer,
# and, for the live stick, where /usr is read from (below)
files_device=$(findmnt -no SOURCE --target "$files")
files_disk=""
if [ -b "$files_device" ]; then
  files_disk=$(lsblk -nslpo NAME,TYPE "$files_device" | awk '$2 == "disk" { disk = $1 } END { print disk }')
  files_disk=${files_disk:-$files_device}
fi
# The ids slot A's partitions are to have, by which the kernel image's
# usrhash= finds them: made of /usr's hash as images/update.sh makes them
# (the data's of its first half, the hashes' of its second, the
# signature's of 'bunix usr-verity-sig <hash>').  Read from that kernel
# image, which names the hash.
usrhash=$(grep -a -o -m 1 'usrhash=[0-9a-f]*' "$uki" | cut -d= -f2)
[ ${#usrhash} = 64 ] || die "$uki names no /usr by its hash (usrhash=)"
usr_id=$(as_id "${usrhash:0:32}")
verity_id=$(as_id "${usrhash:32:32}")
signature_id=$(as_id "$(printf 'bunix usr-verity-sig %s' "$usrhash" | sha256sum | head -c 32)")
# Where /usr's three are read from: files of $files, as a release has
# them; or, on the live stick (images/live.nix), which has none, the
# stick's own partitions, which the system started from it runs /usr
# from (by ids of the stick's own, and the names slot A's have).
# A file's name carries its id, which is to be the one the hash makes.
#   usr_file <the file's pattern> <the id>
usr_file() {
  local found=("$files"/$1)
  [ -e "${found[0]}" ] || die "$files has no file named $1"
  [ ${#found[@]} = 1 ] || die "$files has ${#found[@]} files named $1; a version has one"
  [ "$(uuid_in_name "${found[0]}")" = "$2" ] || die "${found[0]} is not of the /usr $uki starts"
  echo "${found[0]}"
}
#   usr_partition <its name>
usr_partition() {
  local partition
  partition=$(lsblk -nrpo NAME,PARTLABEL "$files_disk" | awk -v name="$1" '$2 == name { print $1 }')
  [ -n "$partition" ] || die "$files has no /usr files, and its disk no partition named $1"
  echo "$partition"
}
usr_files=("$files"/bunix_$release.usr-$ARCHITECTURE.*.raw)
has_usr_files=no
[ ! -e "${usr_files[0]}" ] || has_usr_files=yes
# (each on a line of its own: a failure in $(...) ends the script)
if [ $has_usr_files = yes ]; then
  usr_image=$(usr_file "bunix_$release.usr-$ARCHITECTURE.*.raw" "$usr_id")
  verity_image=$(usr_file "bunix_$release.usr-$ARCHITECTURE-verity.*.raw" "$verity_id")
  signature_image=$(usr_file "bunix_$release.usr-$ARCHITECTURE-verity-sig.*.raw" "$signature_id")
else
  [ -n "$files_disk" ] || die "$files has no file named bunix_$release.usr-$ARCHITECTURE.*.raw"
  usr_image=$(usr_partition "bunix_$release")
  verity_image=$(usr_partition "bunix_${release}_verity")
  signature_image=$(usr_partition "bunix_${release}_verity_sig")
fi
# systemd-boot, from this system's own /usr, the same version's:
# systemd-bootaa64.efi, which goes on an ESP as EFI/BOOT/BOOTAA64.EFI
systemd_boot=$(echo /usr/lib/systemd/boot/efi/systemd-boot*.efi)
[ -f "$systemd_boot" ] || die "this system has no systemd-boot in /usr/lib/systemd/boot/efi"
loader_kind=$(basename "$systemd_boot" .efi)
loader_kind=${loader_kind#systemd-boot}
default_loader=EFI/BOOT/BOOT${loader_kind^^}.EFI
# x86, for Secure Boot: shim, signed by Microsoft, which a PC's firmware
# starts; systemd-boot signed with bunix's key, which shim starts from
# beside it, by the name shim looks for (grub<kind>.efi); MokManager,
# which shim starts to enrol a key; and the certificate of bunix's, for a
# PC's owner to enrol (images/signed-loader.nix).  Where /usr has them,
# these go on the ESP in systemd-boot's place; elsewhere (a Mac, which
# has no Secure Boot) systemd-boot alone.
shim=/usr/lib/shim/shim$loader_kind.efi
mok_manager=/usr/lib/shim/mm$loader_kind.efi
signed_systemd_boot=$systemd_boot.signed
secure_boot_certificate=/usr/share/bunix/secure-boot.cer
has_shim=no
if [ -f "$shim" ] && [ -f "$signed_systemd_boot" ]; then
  has_shim=yes
fi
# The file firmware starts, by its name in bunix's own directory, where
# firmware's default place is another system's (below)
loader_file=systemd-boot$loader_kind.efi
if [ "$has_shim" = yes ]; then
  loader_file=shim$loader_kind.efi
fi
# For an Apple Silicon Mac: what aura's first stage loads from the ESP
# (nix/boot.nix, mac-stage2), from this system's own /usr too: its device
# trees are this version's kernel's.  The place on the ESP is the one the
# first stage is told of (tools/mac-stage1.sh).
mac_stage2=/usr/lib/mac-stage2/stage2.bin
mac_stage2_on_esp=aurora/stage2.bin

echo "bunix $release installer"
echo

# --- the disk -----------------------------------------------------------

# The disk the files are on (files_disk, above) is not a choice
disks=()
while read -r name type size; do
  [ "$type" = disk ] || continue
  [ "$name" = "$files_disk" ] && continue
  # compressed swap in memory (zram-swap), not a disk to install to
  case $name in /dev/zram*) continue ;; esac
  # Nor what bunix could never fit on.  A machine's flash chip is a disk
  # to lsblk, and so are the small parts of a Mac's SSD where Apple
  # keeps the Mac's own settings: nothing to offer, and nothing that may
  # be erased.  (The size as lsblk says it, which is 0 for a card reader
  # with no card in it.)
  [ $((size / MiB)) -ge "$NEEDED_SIZE" ] || continue
  disks+=("$name")
done < <(lsblk -bndpo NAME,TYPE,SIZE)
[ ${#disks[@]} -gt 0 ] || die "no disk of at least $NEEDED_SIZE MiB to install to"

echo "Disks:"
for i in "${!disks[@]}"; do
  printf '  %d) %s  %s  %s\n' $((i + 1)) "${disks[$i]}" \
    "$(lsblk -ndo SIZE "${disks[$i]}")" "$(lsblk -ndo MODEL "${disks[$i]}")"
done
# (asked on its own line: a failed answer then stops the script, which it
# would not inside the array index)
index=$(ask_number "Install to which disk?" ${#disks[@]})
disk=${disks[$index]}

# --- the place on it ----------------------------------------------------

# Each place is "kind start end partitions description": start and end in
# bytes, partitions those to delete, comma-separated (or "-").
sector_size=$(blockdev --getss "$disk")
places=()

# A partition's place on the disk, in bytes: "start end" (sysfs counts in
# 512-byte units, whatever the disk's sector size)
extent_of() {
  local sysfs
  sysfs=/sys/class/block/$(basename "$1")
  local start=$(( $(cat "$sysfs"/start) * 512 ))
  echo "$start $(( start + $(cat "$sysfs"/size) * 512 ))"
}

# One line about a partition, for the lists the person chooses from
describe_partition() {
  local size type_name label fs
  size=$(lsblk -ndo SIZE "$1" | tr -d ' ')
  type_name=$(lsblk -ndo PARTTYPENAME "$1")
  label=$(lsblk -ndo PARTLABEL "$1")
  fs=$(lsblk -ndo FSTYPE "$1")
  echo "$1  $size, $type_name, \"$label\"${fs:+, $fs}"
}

# The disk's ESPs: on most disks one, on a Mac's one for each system
# beside macOS
esps=()
# Every partition on the disk, ESPs included: what stays in place when a
# system is replaced
partitions=()
# Partitions of the types bunix boots by.  The initrd and systemd-boot take
# the first of each type they find on the disk, so another one -- an older
# bunix, say -- has to go first.
discoverable=()
# Every partition of a Linux type (lsblk names them "Linux ...": root, /usr,
# home, swap, LVM, RAID, LUKS, XBOOTLDR), the discoverable ones included
linux_partitions=()
# The releases an earlier bunix's /usr slots are named after
bunix_releases=()
# A Mac's own disk: one with a partition of Apple's
is_a_mac_disk=no
has_apple_silicon_firmware=no
# so that every partition's type is known to lsblk
udevadm settle
while read -r name type; do
  [ "$type" = part ] || continue
  partitions+=("$name")
  part_type=$(lsblk -ndo PARTTYPE "$name")
  # Not told a type, a partition of Apple's would be taken for one that
  # may be deleted
  [ -n "$part_type" ] || die "could not read the type of $name"
  if [ "$part_type" = "$TYPE_ESP" ]; then
    esps+=("$name")
    continue
  fi
  # shellcheck disable=SC2254  # a pattern, meant as one
  case ${part_type,,} in
    $APPLE_TYPES)
      is_a_mac_disk=yes
      [ "${part_type,,}" != $APPLE_SILICON_FIRMWARE_TYPE ] || has_apple_silicon_firmware=yes
      continue ;;
  esac
  case $part_type in
    "$TYPE_ROOT"|"$TYPE_XBOOTLDR"|"$TYPE_USR"|"$TYPE_USR_VERITY"|"$TYPE_USR_VERITY_SIG")
      discoverable+=("$name") ;;
  esac
  type_name=$(lsblk -ndo PARTTYPENAME "$name")
  case $type_name in
    Linux*) linux_partitions+=("$name") ;;
  esac
  if [ "$part_type" = "$TYPE_USR" ]; then
    label=$(lsblk -ndo PARTLABEL "$name")
    case $label in
      bunix_*) bunix_releases+=("${label#bunix_}") ;;
    esac
  fi
  read -r start end < <(extent_of "$name")
  places+=("partition $start $end $name replace $(describe_partition "$name")")
done < <(lsblk -nrpo NAME,TYPE "$disk")

# --- earlier systems on it ----------------------------------------------

# A best guess from the partition table alone: no file system is mounted or
# read.  An earlier bunix is the discoverable partitions, when a /usr slot
# is named after a bunix release; other Linux partitions may be one system
# or several.  Offered on GPT disks only, which bunix-install adds its
# partitions to.

# The free stretch, in bytes, that deleting the given partitions leaves.
# Around each of them, free space reaches back to the nearest partition
# that stays before it and on to the nearest one after it; the largest such
# stretch wins.  Prints "start end".
freed_space() {
  local table first_usable end_usable
  table=$(sfdisk -d "$disk")
  first_usable=$(( $(sed -n 's/^first-lba: //p' <<< "$table") * sector_size ))
  end_usable=$(( ($(sed -n 's/^last-lba: //p' <<< "$table") + 1) * sector_size ))

  local best_start=0 best_end=0
  local deleted deleted_start deleted_end kept kept_start kept_end
  for deleted in "$@"; do
    read -r deleted_start deleted_end < <(extent_of "$deleted")
    local gap_start=$first_usable gap_end=$end_usable
    for kept in "${partitions[@]}"; do
      is_one_of "$kept" "$@" && continue
      read -r kept_start kept_end < <(extent_of "$kept")
      if [ "$kept_end" -le "$deleted_start" ] && [ "$kept_end" -gt "$gap_start" ]; then
        gap_start=$kept_end
      fi
      if [ "$kept_start" -ge "$deleted_end" ] && [ "$kept_start" -lt "$gap_end" ]; then
        gap_end=$kept_start
      fi
    done
    if [ $(( gap_end - gap_start )) -gt $(( best_end - best_start )) ]; then
      best_start=$gap_start
      best_end=$gap_end
    fi
  done
  echo "$best_start $best_end"
}

# A choice that replaces an earlier system, with the partitions it deletes:
# "earlier start end p1,p2,... description"
add_earlier_place() {
  local description=$1; shift
  local start end
  read -r start end < <(freed_space "$@")
  local bytes=0 name part_start part_end
  for name in "$@"; do
    read -r part_start part_end < <(extent_of "$name")
    bytes=$(( bytes + part_end - part_start ))
  done
  local joined
  joined=$(printf '%s,' "$@")
  places+=("earlier $start $end ${joined%,} replace $description: $# partitions, $(numfmt --to=iec "$bytes")")
}

has_gpt=no
if [ "$(lsblk -ndo PTTYPE "$disk")" = gpt ]; then
  has_gpt=yes
fi
has_other_linux=no
for name in "${linux_partitions[@]}"; do
  is_one_of "$name" "${discoverable[@]}" || has_other_linux=yes
done
if [ "$has_gpt" = yes ] && [ ${#linux_partitions[@]} -gt 0 ]; then
  if [ ${#bunix_releases[@]} -gt 0 ]; then
    newest_bunix=$(printf '%s\n' "${bunix_releases[@]}" | sort -V | tail -1)
    add_earlier_place "the earlier bunix $newest_bunix" "${discoverable[@]}"
    if [ "$has_other_linux" = yes ]; then
      add_earlier_place "the earlier bunix $newest_bunix and the other Linux partitions" "${linux_partitions[@]}"
    fi
  else
    add_earlier_place "the Linux system" "${linux_partitions[@]}"
  fi
fi

if sfdisk -d "$disk" >/dev/null 2>&1; then
  # sfdisk -F lists free stretches as "start end sectors size", in sectors
  while read -r first last _; do
    [[ "$first" =~ ^[0-9]+$ && "$last" =~ ^[0-9]+$ ]] || continue
    start=$(( first * sector_size ))
    end=$(( (last + 1) * sector_size ))
    places+=("free $start $end - free space ($(( (end - start) / MiB )) MiB)")
  done < <(sfdisk -F "$disk")
fi
if [ "$is_a_mac_disk" = no ]; then
  places+=("disk 0 $(blockdev --getsize64 "$disk") - the whole disk -- erases everything on it")
fi
[ ${#places[@]} -gt 0 ] || die "$disk has no free space, and no partition that may be deleted"
# Whether the disk has an ESP at all decides if a place needs room for
# one; which of several it is, is asked below
esp=${esps[0]:-}

# Whether bunix fits into a place: its whole MiB, and an ESP if the place
# brings a new one
fits() {
  local kind=$1 start=$2 end=$3 more=${4:-0}
  local first_mib=$(( (start + MiB - 1) / MiB ))
  local end_mib=$(( end / MiB ))
  local needed=$(( NEEDED_SIZE + more ))
  if [ -z "$esp" ] || [ "$kind" = disk ]; then
    needed=$(( needed + ESP_SIZE ))
  fi
  [ $(( end_mib - first_mib )) -ge "$needed" ]
}

echo
echo "On $disk:"
lsblk -o NAME,SIZE,FSTYPE,PARTTYPENAME,PARTLABEL "$disk" | sed 's/^/  /'
echo
if [ "$is_a_mac_disk" = yes ]; then
  echo "This is a Mac's own disk: Apple's partitions stay, and the whole disk"
  echo "is not a choice."
fi
# An Apple Silicon Mac starts a system on its own disk through aura.  Not
# an Intel Mac, which has EFI firmware; nor another disk with partitions
# of Apple's on it, which aura does not read.
starts_through_aura=no
if [ "$has_apple_silicon_firmware" = yes ] && [ "$ARCHITECTURE" = arm64 ]; then
  starts_through_aura=yes
  [ -f "$mac_stage2" ] || die "this is an Apple Silicon Mac's own disk, and this system has nothing to start one with ($mac_stage2)"
fi
# The machine's own firmware (a Mac's, for its Wi-Fi), if this system was
# handed some when it was started: the kernel says where it was told to
# look.  It is copied to the new root further down.  Said now if a Mac
# has none, before anything is deleted: an earlier bunix on this disk may
# have the only copy.
firmware_of_this_boot=$(cat /sys/module/firmware_class/parameters/path)
was_handed_firmware=no
if [ -n "$firmware_of_this_boot" ] && [ -d "$firmware_of_this_boot" ]; then
  was_handed_firmware=yes
fi
if [ "$starts_through_aura" = yes ] && [ "$was_handed_firmware" = no ]; then
  echo "This Mac was started without its own firmware: the installed system"
  echo "will have no Wi-Fi.  (Start it with BUNIX_FIRMWARE to have it kept.)"
fi
echo "Install bunix into (it needs $NEEDED_SIZE MiB, plus $ESP_SIZE MiB if the disk has no ESP):"
for i in "${!places[@]}"; do
  read -r kind start end _ description <<< "${places[$i]}"
  too_small=""
  fits "$kind" "$start" "$end" || too_small="  (too small)"
  printf '  %d) %s%s\n' $((i + 1)) "$description" "$too_small"
done
index=$(ask_number "Which?" ${#places[@]})
read -r kind start end delete_field description <<< "${places[$index]}"
fits "$kind" "$start" "$end" || die "not enough space there"
to_delete=()
if [ "$delete_field" != - ]; then
  read -r -a to_delete <<< "${delete_field//,/ }"
fi
if [ "$kind" != disk ]; then
  for name in "${discoverable[@]}"; do
    is_one_of "$name" "${to_delete[@]}" && continue
    die "$disk already has a root, XBOOTLDR or /usr partition ($name), from an
earlier bunix perhaps; replace it (one of the choices), or install to the
whole disk"
  done
  # The kernel is told its root partition by name: a second of that name,
  # whatever its type, and it may start with the wrong one
  for name in "${partitions[@]}"; do
    is_one_of "$name" "${to_delete[@]}" && continue
    [ "$(lsblk -ndo PARTLABEL "$name")" != "$ROOT_NAME" ] ||
      die "$name is named $ROOT_NAME, the name bunix finds its own root partition by, and
would stay: replace it, or give it another name first"
  done
fi
# The system in memory leaves the disks alone, but the person may have
# mounted one, turned a swap partition on, or unlocked an encrypted one
# (its holder, the mapped device, keeps wipefs out)
for name in "${to_delete[@]}"; do
  in_use=$(lsblk -no MOUNTPOINTS "$name" | tr -d '\n')
  [ -z "$in_use" ] || die "$name is in use ($in_use): unmount it, or turn its swap off, first"
  holders=$(ls /sys/class/block/"$(basename "$name")"/holders | tr '\n' ' ')
  [ -z "$holders" ] || die "$name is open as $holders: close it first (cryptsetup close, dmsetup remove)"
done

# Of several ESPs, the person says which: a Mac starts a system from the
# one its loader was told of, and nothing here can know which that is.
if [ ${#esps[@]} -gt 1 ] && [ "$kind" != disk ]; then
  echo
  echo "$disk has ${#esps[@]} EFI system partitions.  bunix's boot files go on:"
  for i in "${!esps[@]}"; do
    printf '  %d) %s, id %s\n' $((i + 1)) "$(describe_partition "${esps[$i]}")" "$(lsblk -ndo PARTUUID "${esps[$i]}")"
  done
  index=$(ask_number "Which?" ${#esps[@]})
  esp=${esps[$index]}
fi

# An ESP that stays is read, before anything on the disk changes and
# without writing to it (ro): how much room it has, whose loader is in the
# place firmware starts by default, and whether an earlier bunix's
# directory is there (below, where the boot files go, says what each
# decides).  Also read, for the warnings when a system is replaced: other
# systems' boot loaders, and another systemd-boot's settings, which
# bunix's systemd-boot would read too.
esp_other_loaders=""
esp_loader_settings=""
has_loader_conf=no
esp_free_mib=0
default_loader_is_taken=no
has_earlier_bunix_directory=no
if [ -n "$esp" ] && [ "$kind" != disk ]; then
  mount -o ro "$esp" "$WORK"/esp ||
    die "the ESP ($esp) has no file system that can be read; make one first (mkfs.vfat -F 32 $esp)"
  esp_free_mib=$(df --output=avail -B1M "$WORK"/esp | tail -1 | tr -d ' ')
  for dir in "$WORK"/esp/EFI/*/; do
    [ -d "$dir" ] || continue
    dir_name=$(basename "$dir")
    case ${dir_name,,} in boot|linux|bunix) continue ;; esac
    esp_other_loaders+="$dir_name "
  done
  # An earlier bunix's: systemd-boot, which says what it is in a line of
  # its own file, beside a kernel image of bunix's.  Another system's
  # systemd-boot is another system's loader.
  bunix_kernel_images=("$WORK"/esp/EFI/Linux/bunix_*.efi)
  has_bunix_kernel_image=no
  [ ! -e "${bunix_kernel_images[0]}" ] || has_bunix_kernel_image=yes
  # An earlier x86 bunix's own directory (0.4.0's: shim, and systemd-boot
  # under shim's name for it), with its kernel images on an XBOOTLDR
  # partition and not here.  The default place has its shim too where
  # the ESP was its own: then the place is bunix's.
  [ ! -d "$WORK"/esp/EFI/bunix ] || has_earlier_bunix_directory=yes
  if [ -e "$WORK/esp/$default_loader" ]; then
    # systemd-boot, or shim with systemd-boot beside it (as bunix's own
    # disk has them)
    is_systemd_boot=no
    ! grep -q -a 'LoaderInfo: systemd-boot' "$WORK/esp/$default_loader" || is_systemd_boot=yes
    # (shim as this system has it: the file beside alone would take
    # another system's loader for bunix's)
    beside_default_loader=$WORK/esp/$(dirname "$default_loader")/grub$loader_kind.efi
    is_shim=no
    if [ -f "$shim" ] && cmp -s "$shim" "$WORK/esp/$default_loader"; then
      is_shim=yes
    fi
    if [ $is_shim = yes ] && grep -q -a 'LoaderInfo: systemd-boot' "$beside_default_loader" 2>/dev/null; then
      is_systemd_boot=yes
    fi
    is_earlier_bunix_shim=no
    if [ -e "$WORK"/esp/EFI/bunix/shimx64.efi ] && cmp -s "$WORK"/esp/EFI/bunix/shimx64.efi "$WORK/esp/$default_loader"; then
      is_earlier_bunix_shim=yes
    fi
    is_bunix_loader=no
    if [ "$is_systemd_boot" = yes ] && [ "$has_bunix_kernel_image" = yes ]; then
      is_bunix_loader=yes
    fi
    if [ "$is_bunix_loader" = no ] && [ "$is_earlier_bunix_shim" = no ]; then
      default_loader_is_taken=yes
    fi
  fi
  # The same of what aura loads: an earlier bunix's, if a kernel image of
  # bunix's is beside it; else what another system on this Mac starts by.
  mac_stage2_is_taken=no
  if [ -e "$WORK/esp/$mac_stage2_on_esp" ] && [ "$has_bunix_kernel_image" = no ]; then
    mac_stage2_is_taken=yes
  fi
  if [ -e "$WORK"/esp/loader/loader.conf ]; then
    has_loader_conf=yes
    esp_loader_settings=$(grep -E '^(default|timeout)' "$WORK"/esp/loader/loader.conf | tr '\n' ' ' || true)
  fi
  umount "$WORK"/esp
  if [ "$starts_through_aura" = yes ] && [ "$mac_stage2_is_taken" = yes ]; then
    die "the ESP ($esp) has what another system on this Mac is started by
($mac_stage2_on_esp), and bunix's would take its place.  If that system is the
one being replaced, move the file away first, and run bunix-install again."
  fi
fi

# --- where the boot files go --------------------------------------------

# What starts bunix (shim, or systemd-boot) in the place firmware starts
# by default, and the kernel images on the ESP, as on a disk of
# images/disk.nix; unless the ESP that is there says otherwise.  Decided
# before anything on the disk changes.
loader_on_esp=$default_loader
writes_boot_entry=no
needs_xbootldr=no
if [ -n "$esp" ] && [ "$kind" != disk ]; then
  # Too small for the kernel images (as Windows makes an ESP): they go on
  # an XBOOTLDR partition of their own, which the place has to have room
  # for too
  if [ "$esp_free_mib" -lt $ESP_NEEDED_FREE ]; then
    [ "$esp_free_mib" -ge $ESP_LOADER_FREE ] || die "the ESP ($esp) has only $esp_free_mib MiB free; bunix needs $ESP_LOADER_FREE"
    needs_xbootldr=yes
    has_room=no
    fits "$kind" "$start" "$end" $XBOOTLDR_SIZE && has_room=yes
    [ "$has_room" = yes ] || die "the ESP ($esp) has room for systemd-boot only, and the kernel images
need a partition of their own ($XBOOTLDR_SIZE MiB) beside bunix's, which the place
chosen has no room for"
  fi
  # Firmware's default place another system's (Windows'): what starts
  # bunix in bunix's own directory, and a firmware boot entry for it.  A
  # Mac keeps no entries, and its firmware takes no other place.
  if [ "$default_loader_is_taken" = yes ]; then
    can_write_boot_entries=no
    if [ -d /sys/firmware/efi/efivars ] && [ "$starts_through_aura" = no ]; then
      can_write_boot_entries=yes
    fi
    [ "$can_write_boot_entries" = yes ] || die "the ESP ($esp) has another system's loader as the one firmware starts
by default ($default_loader), and this machine keeps no firmware boot entries
for bunix's beside it.  If that system is the one being replaced, move the
file away first, and run bunix-install again."
    loader_on_esp=EFI/bunix/$loader_file
    writes_boot_entry=yes
  fi
  echo
  echo "bunix's boot files go on the ESP that is there, $esp."
  if [ "$needs_xbootldr" = yes ]; then
    echo "It has no room for bunix's kernel images: they go on a partition of their"
    echo "own beside bunix's ($XBOOTLDR_SIZE MiB)."
  fi
  if [ "$writes_boot_entry" = yes ]; then
    echo "Its default loader is another system's, which stays: bunix's goes in"
    echo "EFI/bunix/, and the firmware is told to start bunix first."
  fi
  if [ "$has_earlier_bunix_directory" = yes ]; then
    echo "An earlier bunix's EFI/bunix/ (its shim), and the firmware's entries for"
    echo "it, are replaced."
  fi
fi

# Secure Boot on: what starts bunix has to be shim's chain, which a system
# without shim in its /usr does not have; the firmware would refuse
# systemd-boot alone.  With it, shim starts systemd-boot if it knows
# bunix's key, as a PC that had bunix before does; else it shows
# MokManager at the first start, where the key is enrolled once.
secure_boot_variable=/sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c
secure_boot_is_on=no
if [ -r "$secure_boot_variable" ] && [ "$(od -An -t u1 -j 4 -N 1 "$secure_boot_variable" | tr -d ' ')" = 1 ]; then
  secure_boot_is_on=yes
fi
if [ "$secure_boot_is_on" = yes ]; then
  [ "$has_shim" = yes ] || die "Secure Boot is on, and this system has no boot loader signed for it
(shim): the firmware would not start bunix.  Turn Secure Boot off in the
firmware's settings, and keep it off for bunix."
  echo
  echo "Secure Boot is on.  A PC that does not know bunix's key yet shows a blue"
  echo "screen at bunix's first start (MokManager): choose \"Enroll key from disk\","
  echo "the ESP, $(dirname "$loader_on_esp")/bunix.cer, and confirm; it then starts bunix."
fi

# --- the system and its user --------------------------------------------

# Asked, and checked, before anything on the disk changes: a failure
# later would leave the disk half installed
look=console
if [ -f "$desktop_image" ]; then
  echo
  echo "A desktop (niri with DMS), or the console alone."
  echo "\"bunix ext enable desktop\" adds the desktop later, from tty2 or over SSH."
  echo "  1) desktop"
  echo "  2) console"
  looks=(desktop console)
  index=$(ask_number "Which?" ${#looks[@]})
  look=${looks[$index]}
fi

echo
host_name=$(ask "This computer's name, on the network (like \"sara-laptop\"):")
host_name=${host_name,,}
# One DNS label (hostname(7)): networkd sends it to the DHCP server, whose
# DNS may answer for it.  A letter first, as RFC 952 has it: "1234" would
# be read as an IPv4 address.
valid_host_name='^[a-z]([a-z0-9-]{0,61}[a-z0-9])?$'
[[ "$host_name" =~ $valid_host_name ]] ||
  die "a computer's name is letters, digits and '-', at most 63, starting with a letter and not ending with '-': $host_name"
# systemd takes it for "no name set"
[ "$host_name" != localhost ] || die "\"localhost\" is every computer's name for itself"

echo
echo "Your account.  It can run administrator commands (run0); root itself"
echo "cannot log in."
full_name=$(ask "Your name:")
# (they separate the fields of /etc/passwd and of its name field)
case $full_name in
  *:*|*,*) die "the name cannot contain ':' or ','" ;;
esac

user_name=$(ask "User name (lower case, like \"sara\"):")
valid_user_name='^[a-z_][a-z0-9_-]{0,31}$'
[[ "$user_name" =~ $valid_user_name ]] ||
  die "a user name is lower-case letters, digits, '-' and '_', starting with a letter or '_': $user_name"
# The system's own accounts and groups: the system in memory has the same
# ones as the installed system.  useradd also makes a group of the user's
# name, so that name must be free too.
taken=no
getent passwd "$user_name" >/dev/null && taken=yes
getent group "$user_name" >/dev/null && taken=yes
[ "$taken" = no ] || die "\"$user_name\" is one of the system's own names"

echo
echo "Your shell, which reads what you type.  chsh changes it later."
echo "  1) bash"
echo "  2) fish"
shells=(/usr/bin/bash /usr/bin/fish)
index=$(ask_number "Which?" ${#shells[@]})
shell=${shells[$index]}
[ -x "$shell" ] || die "this system has no $shell"

password=$(ask_secret "Password:")
[ -n "$password" ] || die "the password is empty"
password_again=$(ask_secret "Password again:")
[ "$password" = "$password_again" ] || die "the passwords differ"

# --- confirm, then clear the place --------------------------------------

case $kind in
  disk)
    confirm=$(ask "ERASE all of $disk? Type the disk's name ($disk) to go on:")
    [ "$confirm" = "$disk" ] || die "cancelled"
    wipefs -q -a "$disk"
    echo 'label: gpt' | sfdisk -q "$disk"
    esp=""
    # the whole disk is now one free stretch
    read -r first last _ < <(sfdisk -F "$disk" | grep -E '^ *[0-9]+ +[0-9]+ ' | head -1)
    start=$(( first * sector_size ))
    end=$(( (last + 1) * sector_size ))
    ;;
  partition)
    confirm=$(ask "DELETE $delete_field and everything on it? Type its name ($delete_field) to go on:")
    [ "$confirm" = "$delete_field" ] || die "cancelled"
    wipefs -q -a "$delete_field"
    sfdisk -q --delete "$disk" "$(cat /sys/class/block/"$(basename "$delete_field")"/partition)"
    ;;
  earlier)
    echo
    echo "These partitions on $disk are DELETED, with everything on them:"
    for name in "${to_delete[@]}"; do
      echo "  $(describe_partition "$name")"
    done
    echo
    echo "Check this list.  It is a guess from the partition table: bunix-install"
    echo "goes by the partitions' types and names and does not look inside them."
    echo "  - Your files on them are lost, /home included.  Back them up first."
    for name in "${to_delete[@]}"; do
      case $(lsblk -ndo FSTYPE "$name") in
        crypto_LUKS) echo "  - $name is encrypted: what is in it cannot be seen." ;;
        LVM2_member) echo "  - $name holds LVM volumes; a volume group can reach over other"
                     echo "    disks, whose volumes then stop working too." ;;
        linux_raid_member) echo "  - $name is part of a RAID array, which may reach over other disks." ;;
      esac
    done
    for name in "${to_delete[@]}"; do
      read -r part_start _ < <(extent_of "$name")
      is_inside=no
      if [ "$part_start" -ge "$start" ] && [ "$part_start" -lt "$end" ]; then
        is_inside=yes
      fi
      [ "$is_inside" = yes ] && continue
      echo "  - $name is elsewhere on the disk: bunix goes into the largest freed"
      echo "    stretch ($(( (end - start) / MiB )) MiB), and $name's space stays free."
    done
    if [ "$has_loader_conf" = yes ]; then
      echo "  - The ESP has systemd-boot settings (loader/loader.conf:"
      echo "    ${esp_loader_settings:-no default}), which may start the old system."
      echo "    They are kept as loader/loader.conf.before-bunix, and bunix's, with"
      echo "    bunix as the default, take their place."
    fi
    if [ -n "$esp_other_loaders" ]; then
      echo "  - The ESP ($esp) stays, and so do other systems' boot files in it"
      echo "    (EFI/: $esp_other_loaders), which may then start nothing."
    fi
    echo
    confirm=$(ask "DELETE these ${#to_delete[@]} partitions? Type the disk's name ($disk) to go on:")
    [ "$confirm" = "$disk" ] || die "cancelled"
    # the numbers first: a partition wiped and then found busy would stop
    # the script with the table unchanged
    numbers=()
    for name in "${to_delete[@]}"; do
      numbers+=("$(cat /sys/class/block/"$(basename "$name")"/partition)")
    done
    for name in "${to_delete[@]}"; do
      wipefs -q -a "$name"
    done
    sfdisk -q --delete "$disk" "${numbers[@]}"
    ;;
  free)
    confirm=$(ask "Install into this free space? [yes/no]")
    [ "$confirm" = yes ] || die "cancelled"
    ;;
esac

# --- partitions ---------------------------------------------------------

# Laid out one after another from the start of the place, in whole MiB;
# root takes what is left of it.  sfdisk gets each partition's exact position,
# so nothing lands in some other free stretch of the disk.
position=$(( (start + MiB - 1) / MiB ))
place_end=$(( end / MiB ))
script=""
add_partition() {
  local size=$1 type=$2 name=$3 uuid=$4 attributes=${5:-}
  local line="start=${position}MiB, type=$type, name=\"$name\", uuid=$uuid"
  [ "$size" = rest ] || line="$line, size=${size}MiB"
  [ -z "$attributes" ] || line="$line, attrs=\"$attributes\""
  script+="$line"$'\n'
  [ "$size" = rest ] || position=$(( position + size ))
}

new_esp=no
if [ -z "$esp" ]; then
  new_esp=yes
  esp_uuid=$(new_uuid)
  add_partition $ESP_SIZE $TYPE_ESP "ESP" "$esp_uuid"
fi
if [ "$needs_xbootldr" = yes ]; then
  xbootldr_uuid=$(new_uuid)
  add_partition $XBOOTLDR_SIZE $TYPE_XBOOTLDR "bunix-boot" "$xbootldr_uuid"
fi
root_uuid=$(new_uuid)
# Slot A: read-only (GPT attribute 60), as images/disk.sh makes it
add_partition $USR_SIZE $TYPE_USR "bunix_$release" "$usr_id" GUID:60
add_partition $USR_VERITY_SIZE $TYPE_USR_VERITY "bunix_${release}_verity" "$verity_id" GUID:60
add_partition $USR_SIGNATURE_SIZE $TYPE_USR_VERITY_SIG "bunix_${release}_verity_sig" "$signature_id" GUID:60
# Slot B: "_empty" is where sysupdate writes the next release
add_partition $USR_SIZE $TYPE_USR "_empty" "$(new_uuid)"
add_partition $USR_VERITY_SIZE $TYPE_USR_VERITY "_empty" "$(new_uuid)"
add_partition $USR_SIGNATURE_SIZE $TYPE_USR_VERITY_SIG "_empty" "$(new_uuid)"
root_size=$(( place_end - position ))
[ "$root_size" -ge "$ROOT_MIN_SIZE" ] || die "not enough space: root would get $root_size MiB, it needs $ROOT_MIN_SIZE"
# With no size said, sfdisk gives it all up to the next partition: the
# rest of the place, and free space that comes right after the place.
# The first boot would give it that anyway (the top of this file).
add_partition rest $TYPE_ROOT "$ROOT_NAME" "$root_uuid"

echo "Creating partitions..."
# udev looks at a disk again whenever its partitions change, as they just
# did where something was deleted.  While it looks, the kernel refuses to
# read the new table as a whole, and sfdisk only remarks on it: the new
# partitions would never appear.  So udev is waited for first; and the
# kernel is told of the partitions one by one as well (partx), which it
# takes even from a disk that is in use.
udevadm settle
printf '%s' "$script" | sfdisk -q --append "$disk"
partx --update "$disk"
udevadm settle

echo "Writing /usr ($release)..."
dd if="$usr_image" of="$(device_of_partuuid "$usr_id")" bs=4M conv=fsync status=none
dd if="$verity_image" of="$(device_of_partuuid "$verity_id")" bs=4M conv=fsync status=none
dd if="$signature_image" of="$(device_of_partuuid "$signature_id")" bs=4M conv=fsync status=none
# Read back through dm-verity, against the hash the kernel image names: a
# stick or a file that is not what it was made as (a worn stick) fails
# the install here, and not the machine's first start.  Under a name of
# its own: the live system's /usr is "usr".
echo "Checking /usr as written..."
/usr/lib/systemd/systemd-veritysetup attach $read_back_device "$(device_of_partuuid "$usr_id")" \
  "$(device_of_partuuid "$verity_id")" "$usrhash" ||
  die "could not set up /usr as written to $disk to be checked against its hash"
reads_whole=yes
dd if=/dev/mapper/$read_back_device of=/dev/null bs=4M status=none || reads_whole=no
/usr/lib/systemd/systemd-veritysetup detach $read_back_device ||
  die "could not close /dev/mapper/$read_back_device after checking /usr"
[ $reads_whole = yes ] || die "/usr as written to $disk does not match its hash: the stick, or the files,
are damaged.  Write the stick again, or download the files again."

echo "Writing the boot files..."
if [ "$new_esp" = yes ]; then
  esp=$(device_of_partuuid "$esp_uuid")
  mkfs.vfat -F 32 -n ESP "$esp" >/dev/null
fi
mount "$esp" "$WORK"/esp
if [ "$has_earlier_bunix_directory" = yes ]; then
  # An earlier bunix's own directory, x86's (shim, and systemd-boot under
  # shim's name for it): this one's systemd-boot takes its place, where it
  # goes there
  rm -rf "$WORK"/esp/EFI/bunix
fi
mkdir -p "$WORK/esp/$(dirname "$loader_on_esp")" "$WORK"/esp/EFI/Linux "$WORK"/esp/loader
# Where firmware looks when it has no entry for a disk, which is all a
# Mac's ever does (checked above: the place is free, or an earlier
# bunix's); or bunix's own directory, which an entry names (below).  What
# starts bunix: above, where $has_shim is decided.
if [ "$has_shim" = yes ]; then
  loader_directory=$WORK/esp/$(dirname "$loader_on_esp")
  # Shim starts fallback (fbx64.efi) in place of systemd-boot where one is
  # beside it, which another system may have left in EFI/BOOT: it makes
  # firmware entries of what other systems left, and starts those
  rm -f "$loader_directory/fb$loader_kind.efi"
  cp "$shim" "$WORK/esp/$loader_on_esp"
  cp "$signed_systemd_boot" "$loader_directory/grub$loader_kind.efi"
  cp "$mok_manager" "$loader_directory/"
  cp "$secure_boot_certificate" "$loader_directory/bunix.cer"
else
  cp "$systemd_boot" "$WORK/esp/$loader_on_esp"
fi
# An earlier bunix's kernel images, whose /usr is gone: systemd-boot would
# start the newest version among them and this one
rm -f "$WORK"/esp/EFI/Linux/bunix_*.efi
# The kernel image, under the name systemd-boot and sysupdate know an
# installed one by: on the ESP, or on the XBOOTLDR partition, which
# systemd-boot reads as well, and the installed system mounts at /boot,
# where updates put the next (usr/lib/sysupdate.d/90-uki.transfer)
kernel_images=$WORK/esp/EFI/Linux
if [ "$needs_xbootldr" = yes ]; then
  xbootldr=$(device_of_partuuid "$xbootldr_uuid")
  mkfs.vfat -F 32 -n BUNIX-BOOT "$xbootldr" >/dev/null
  mkdir -p "$WORK"/boot
  mount "$xbootldr" "$WORK"/boot
  kernel_images=$WORK/boot/EFI/Linux
  mkdir -p "$kernel_images"
fi
cp "$uki" "$kernel_images/bunix_$release.efi"
if [ "$starts_through_aura" = yes ]; then
  mkdir -p "$WORK/esp/$(dirname "$mac_stage2_on_esp")"
  # Under another name until it is whole: a Mac that already starts from
  # this ESP is not left with half of the file
  cp "$mac_stage2" "$WORK/esp/$mac_stage2_on_esp.new"
  mv "$WORK/esp/$mac_stage2_on_esp.new" "$WORK/esp/$mac_stage2_on_esp"
fi
# The menu stays hidden, and lists only bunix (as images/disk.sh)
loader_settings=$'timeout 0\nconsole-mode keep\nauto-entries no'
loader_conf=$WORK/esp/loader/loader.conf
if [ "$kind" = earlier ]; then
  # A replaced system's systemd-boot settings, or its entries, which sort
  # before bunix's, would start the old system: bunix's settings take
  # their place, with bunix's kernel images as the default (the
  # confirmation said so).  The first ones kept stay the ones kept.
  if [ -e "$loader_conf" ] && [ ! -e "$loader_conf".before-bunix ]; then
    mv "$loader_conf" "$loader_conf".before-bunix
  fi
  printf '%s\n' "$loader_settings" 'default bunix_*' > "$loader_conf"
elif [ ! -e "$loader_conf" ]; then
  printf '%s\n' "$loader_settings" > "$loader_conf"
fi

echo "Creating the root file system..."
mkfs.ext4 -q -F "$(device_of_partuuid "$root_uuid")"
mount "$(device_of_partuuid "$root_uuid")" "$WORK"/root
# What systemd-repart would make of a new root (usr/lib/repart.d/50-root.conf):
# the mount points, the journal's directory, and the merged-/usr links at
# the top (UAPI.9)
mkdir -p "$WORK"/root/usr "$WORK"/root/etc "$WORK"/root/var/log/journal "$WORK"/root/home \
         "$WORK"/root/srv "$WORK"/root/tmp
ln -s usr/bin "$WORK"/root/bin
ln -s usr/bin "$WORK"/root/sbin
ln -s usr/lib "$WORK"/root/lib
# only x86 asks for its loader there
if [ "$ARCHITECTURE" = x86-64 ]; then
  ln -s usr/lib/x86_64-linux-gnu "$WORK"/root/lib64
fi

# The machine's own firmware, which the installed system is handed by
# nobody, and finds here (usr/lib/bunix/vendor-firmware).
if [ "$was_handed_firmware" = yes ]; then
  echo "Keeping this machine's firmware..."
  # Into a directory made here, and the directory's contents: the place
  # the kernel was told of may be a link to one.
  mkdir -p "$WORK"/root/var/lib/vendorfw
  cp -a "$firmware_of_this_boot"/. "$WORK"/root/var/lib/vendorfw/
fi


# --- the system and its user, on the new root ---------------------------

# Before the first boot, whose tmpfiles copy the factory name ("bunix")
# only when /etc/hostname is missing
echo "$host_name" > "$WORK"/root/etc/hostname

echo "Creating your account..."
# The system's own accounts first, so that wheel exists to join: made as
# the first boot would make them, from /usr's sysusers.d.  The new root
# has no /usr of its own (that is the verity partition, mounted at boot),
# so they come from this system's, the same version's.  (Errors only: it
# would list every account it makes, and warn that root is asked for
# twice, which usr/lib/sysusers.d/00-bunix-root.conf means to.)
cat /usr/lib/sysusers.d/*.conf | SYSTEMD_LOG_LEVEL=err systemd-sysusers --root="$WORK"/root -
# useradd's defaults (the id range, the password hash), which the first
# boot would copy too
mkdir -p "$WORK"/root/etc/default
cp /usr/share/factory/etc/login.defs "$WORK"/root/etc/
cp /usr/share/factory/etc/default/useradd "$WORK"/root/etc/default/
useradd --prefix "$WORK"/root --create-home --comment "$full_name" --groups wheel \
  --shell "$shell" "$user_name"
printf '%s:%s\n' "$user_name" "$password" | chpasswd --prefix "$WORK"/root
# Root: a random password, locked.  Without a hash console-shell would take
# root for a machine nobody has set up yet and open its shell.
printf 'root:%s\n' "$(head -c 32 /dev/urandom | base64)" | chpasswd --prefix "$WORK"/root
usermod --prefix "$WORK"/root --lock root

# After the accounts: a copy this large that fails would otherwise leave
# a disk that starts with no accounts, and opens root's shell on tty1
if [ "$look" = desktop ]; then
  echo "Adding the desktop..."
  # Where an update keeps a version's extensions, read-only as it leaves
  # them, under the version it names them by, which is the release
  # (usr/lib/sysupdate.d/54-desktop.transfer): the first boot lays it
  # over /usr from there
  install -D -m 0444 "$desktop_image" "$WORK/root/var/lib/bunix/extensions/desktop_$release.raw"
  # and the machine's choice to have it, which updates go by, written as
  # `bunix ext enable` writes it (src/bunix/src/ext.rs)
  mkdir -p "$WORK"/root/etc/sysupdate.d/desktop.feature.d
  printf '[Feature]\nEnabled=true\n' > "$WORK"/root/etc/sysupdate.d/desktop.feature.d/enable.conf
fi

# The firmware's entries: an earlier bunix's on this ESP (by its id), which
# name a loader that is gone, or this one twice; and, where bunix's
# systemd-boot is not in the default place, an entry for it, first in the
# firmware's boot order (efibootmgr --create puts it there).  Last, once
# the disk is whole: the machine's first choice is then a system that
# starts.  (efibootmgr -v: each entry with its path, which has the ESP's
# id; an entry not active is "Boot0001  bunix", one active "Boot0001*".)
esp_id=$(lsblk -ndo PARTUUID "$esp")
if [ "$has_earlier_bunix_directory" = yes ] || [ "$writes_boot_entry" = yes ]; then
  # (none is no failure: grep's 1 would end the script)
  entries_on_this_esp=$(efibootmgr -v | grep -i -F "$esp_id" || true)
  earlier_entries=$(printf '%s\n' "$entries_on_this_esp" | sed -n -E 's/^Boot([0-9A-Fa-f]{4})[* ] bunix(\t.*)?$/\1/p')
  for number in $earlier_entries; do
    efibootmgr --quiet --bootnum "$number" --delete-bootnum
  done
fi
if [ "$writes_boot_entry" = yes ]; then
  echo "Adding bunix to the firmware's boot entries..."
  esp_number=$(cat /sys/class/block/"$(basename "$esp")"/partition)
  efibootmgr --quiet --create --disk "$disk" --part "$esp_number" --label bunix \
    --loader "\\${loader_on_esp//\//\\}"
fi
sync

# --- done ---------------------------------------------------------------

echo
echo "bunix $release is installed on $disk."
if [ "$look" = desktop ]; then
  echo "Log in as \"$user_name\" at the login screen."
else
  echo "Log in as \"$user_name\"."
fi
if [ "$starts_through_aura" = yes ]; then
  echo "A Mac starts it once the Mac is told, in its recovery system, to start"
  echo "aura's first stage made for this ESP, which this installer does not do."
  echo "On the computer bunix is built on, while this system still runs:"
  echo "  tools/mac-stage1.sh $(lsblk -ndo PARTUUID "$esp") put root@<this Mac's address>"
  echo "It puts on the ESP what the recovery system needs, and says what to do."
else
  if [ "$writes_boot_entry" = yes ]; then
    echo "It starts first now: the firmware's boot entry for it comes before the"
    echo "others.  The other system is in the firmware's boot menu."
  else
    echo "It starts when the machine's firmware starts this disk; choose the disk"
    echo "in the firmware's boot menu if another system starts first."
  fi
fi
