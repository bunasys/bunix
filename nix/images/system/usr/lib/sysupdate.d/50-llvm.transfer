# The llvm extension (llvm.feature), built with each release, and kept on
# the machine as the devtools extension is: 53-devtools.transfer says
# why, and how.  (After files/rootfs's 50-gcc.transfer.)
[Transfer]
Features=llvm
ProtectVersion=%A

[Source]
Type=url-file
Path=https://github.com/bunasys/bunix/releases/latest/download/
MatchPattern=llvm_@v.%a.raw

[Target]
Type=regular-file
Path=/var/lib/bunix/extensions
MatchPattern=llvm_@v.raw
Mode=0444
InstancesMax=2
