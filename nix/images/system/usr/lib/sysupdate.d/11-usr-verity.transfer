# The hashes of /usr's blocks (see 10-usr.transfer)
[Transfer]
ProtectVersion=%A

[Source]
Type=url-file
Path=https://github.com/bunasys/bunix/releases/latest/download/
MatchPattern=bunix_@v.usr-%a-verity.@u.raw

[Target]
Type=partition
Path=auto
MatchPattern=bunix_@v_verity
MatchPartitionType=usr-verity
ReadOnly=1
