# What runs is decided by the image: these, and nothing a package would
# have liked.  Applied when the image is made (images/system.sh).
enable systemd-networkd.service
enable systemd-resolved.service
enable systemd-timesyncd.service
enable sshd.service
enable iwd.service
# a root shell on the screen, and on the serial port of a virtual machine
# and of a Mac
enable console-shell@.service tty1 ttyAMA0 ttySAC0
disable *
