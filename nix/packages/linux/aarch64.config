# What bunix's kernel has that arm64's defconfig does not, or the other
# way round.  Every line here must be in the final configuration, or the
# build fails (linux.sh).

# 16K pages: what Apple Silicon's own page size is, and what its GPU and
# storage drivers assume.  Programs that guess 4K break here, in the VM,
# before they break on the Mac.
CONFIG_ARM64_16K_PAGES=y

# The file system the kernel keeps its devices in, which /init mounts on
# /dev (init.sh).
CONFIG_DEVTMPFS=y

# No certificates built into the kernel: nothing checks a signature yet,
# and building them in needs OpenSSL, which is not a package yet.  Wi-Fi
# is what asks for them, to check the signature of the regulatory
# database; it goes with them for now.
# CONFIG_SYSTEM_TRUSTED_KEYRING is not set
# CONFIG_CFG80211 is not set

# Modules stay configured as defconfig has them, but only the kernel image
# is built (linux.sh): what defconfig makes a module is not there yet.
# Turning modules off would not leave those drivers out, it would build
# every one of them into the image.
