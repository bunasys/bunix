# What bunix's kernel has on top of x86_64's defconfig, after
# files/linux/x86_64.fragment, the kernel of bunix on x86 so far.  Every
# line here must be in the final configuration, or the build fails
# (linux.sh).
#
# What is not as there:
#
#   - The source is Aurora Silicon's Linux 7.3 (boot.nix), not
#     kernel.org's 6.18, and it is built with clang, not gcc.
#   - No modules.  Only the kernel image is built, and bunix loads no
#     modules yet (as boot/linux/aarch64.config).  What the fragment has
#     as a module is built in if it needs no firmware and is small, and
#     left out otherwise: the drivers of real GPUs, Wi-Fi, Bluetooth and
#     sound, the wired network chips that load firmware; KVM, WireGuard,
#     the bridge.  This kernel is for a virtual machine, and for a PC
#     with a wired network and the firmware's own picture on its screen.
#   - No BTF (the kernel's types, for BPF tools): it is made by pahole,
#     which is not a package here yet.  With it go what cannot be used
#     without it: the function tracer, and security policies as BPF
#     programs.
#   - An initramfs is gzip's here (images/image.sh), so nothing asks for
#     zstd's.
#   - Added: what hands a virtual machine things from outside (below).
#
# Kept as the fragment has them, though nothing in this system uses them
# yet: the firewall, swap in memory, the TPM.

# No modules: see above.  It also keeps the image the same from build to
# build: lockdown, below, asks for signed modules where there are any,
# and to sign them the kernel makes a new key in every build.
# (aarch64.config, which keeps modules in its configuration, gives up
# lockdown instead.)
# CONFIG_MODULES is not set

# What the architecture's default configuration builds in, and the
# fragment has as modules, beside their firmware in /usr: with no
# modules, and no firmware in the image, they are left out.  Intel's
# GPUs; Realtek's and Broadcom's wired network chips; the sound
# controller, which has no codec's driver to go with it; and the 802.11
# stack no chip's driver here uses.
# CONFIG_DRM_I915 is not set
# CONFIG_R8169 is not set
# CONFIG_TIGON3 is not set
# CONFIG_SND_HDA_INTEL is not set
# CONFIG_MAC80211 is not set

# the system in memory, or the part of it that finds the rest, is an
# initramfs
CONFIG_BLK_DEV_INITRD=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# what systemd expects of a kernel
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_FHANDLE=y
CONFIG_AUTOFS_FS=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_INOTIFY_USER=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y

# UEFI
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y

# console: VGA text, the firmware framebuffer, and serial
CONFIG_VGA_CONSOLE=y
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
# fbcon sits on DRM's fbdev emulation
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_CLIENT_DEFAULT_FBDEV=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# fbcon leaves the screen alone, and the firmware's picture on it, until
# text is written to the console.  No penguin either.
# (it needs the fbdev layer itself, without its firmware framebuffer
# drivers: simpledrm has the screen)
CONFIG_FB=y
# CONFIG_FB_EFI is not set
# CONFIG_FB_VESA is not set
CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=y
# CONFIG_LOGO is not set
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# virtual machines' GPUs (QEMU's standard VGA and virtio-gpu), which need
# no firmware: built in here, modules in the fragment
CONFIG_DRM_BOCHS=y
CONFIG_DRM_VIRTIO_GPU=y

# keyboards: PS/2 and USB
CONFIG_KEYBOARD_ATKBD=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y

# Touchpads and touch screens are read through evdev.  Laptops wire them
# over I2C, which on Intel needs the LPSS I2C controllers and the GPIO
# controller of the platform (pinctrl) for their interrupt lines.  The
# two drivers nearly all of them use need no firmware, and are built in
# here (modules in the fragment); those of single makes are left out.
CONFIG_INPUT_EVDEV=y
CONFIG_HID_MULTITOUCH=y
CONFIG_I2C_HID_ACPI=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_MOUSE_PS2=y
CONFIG_I2C=y
CONFIG_GPIOLIB=y
CONFIG_PINCTRL=y
CONFIG_COMMON_CLK=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_I2C_DESIGNWARE_PCI=y
CONFIG_MFD_INTEL_LPSS_ACPI=y
CONFIG_MFD_INTEL_LPSS_PCI=y
CONFIG_PINCTRL_INTEL_PLATFORM=y
CONFIG_PINCTRL_SUNRISEPOINT=y
CONFIG_PINCTRL_CANNONLAKE=y
CONFIG_PINCTRL_ICELAKE=y
CONFIG_PINCTRL_JASPERLAKE=y
CONFIG_PINCTRL_TIGERLAKE=y
CONFIG_PINCTRL_ALDERLAKE=y
CONFIG_PINCTRL_METEORLAKE=y

# Input devices made by programs, not hardware.  Only root can open it.
CONFIG_INPUT_UINPUT=y

# networking: AF_PACKET is what DHCP clients use
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y

# wired NICs found in common PCs, laptops and USB dongles; not the ones
# that load firmware (Realtek's r8169, Broadcom's tg3 and bnx2: see the
# top of this file)
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_IGC=y
CONFIG_IXGBE=y
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_8139CP=y
CONFIG_8139TOO=y
CONFIG_NET_VENDOR_ATHEROS=y
CONFIG_ALX=y
CONFIG_ATL1C=y
CONFIG_NET_VENDOR_MARVELL=y
CONFIG_SKGE=y
CONFIG_SKY2=y
CONFIG_NET_VENDOR_AQUANTIA=y
CONFIG_AQTION=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_RTL8152=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y

# QEMU / KVM guests
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM_VIRTIO=y
# What a virtual machine is handed from outside, which systemd reads
# there: strings of the firmware's tables, and QEMU's own files.  A test
# gives the machine its SSH key so.
CONFIG_DMI_SYSFS=y
CONFIG_FW_CFG_SYSFS=y

# disks and their file systems
CONFIG_BLK_DEV_NVME=y
CONFIG_SATA_AHCI=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y

# set the system clock from the RTC, so TLS certificates validate before
# timesyncd has synchronised
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_CMOS=y

# Wi-Fi: no chip's driver yet (see the top of this file).  The radio
# switch and the 802.11 configuration interface are here because iwd,
# which the system starts, asks for them.
CONFIG_WIRELESS=y
CONFIG_RFKILL=y
CONFIG_CFG80211=y

# what iwd needs from the kernel: hashes and ciphers through AF_ALG, and the
# keyring's DH and certificate parsers (for WPA3/SAE and WPA-Enterprise)
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_MD4=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_DES=y
CONFIG_KEYS=y
CONFIG_KEY_DH_OPERATIONS=y
CONFIG_ASYMMETRIC_KEY_TYPE=y
CONFIG_ASYMMETRIC_PUBLIC_KEY_SUBTYPE=y
CONFIG_X509_CERTIFICATE_PARSER=y
CONFIG_PKCS7_MESSAGE_PARSER=y
CONFIG_PKCS8_PRIVATE_KEY_PARSER=y

# Sandboxes: user namespaces and FUSE
CONFIG_USER_NS=y
CONFIG_FUSE_FS=y

# A firewall: nftables, with connection tracking, and NAT
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_LIMIT=y
CONFIG_NF_NAT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y

# Swap in memory, compressed with zstd
CONFIG_SWAP=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y

# The TPM (discrete chips and the firmware TPMs of Intel PTT and AMD fTPM,
# through TIS and CRB), for a systemd built to use it, which this one is
# not yet (base/systemd.sh): it measures the extension images' verity
# root hashes into it.
CONFIG_TCG_TPM=y
CONFIG_TCG_TIS=y
CONFIG_TCG_CRB=y
# the firmware's TPM event log is read through securityfs; without it
# systemd reports the TPM as "firmware unavailable" and measures nothing
CONFIG_SECURITYFS=y

# /usr read-only and checked, and extensions laid over it
# (docs/updates.md): erofs is the images' file system, dm-verity checks
# every block as it is read, overlayfs lays an extension over /usr.  The
# kernel takes an extension only if its root hash is signed by a key in
# the system keyring: bunix's certificate (keys/verity.crt), built in,
# which linux.sh puts at this place in the source.
CONFIG_OVERLAY_FS=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_ZIP_LZMA=y
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
CONFIG_DM_VERITY_VERIFY_ROOTHASH_SIG=y
CONFIG_SYSTEM_TRUSTED_KEYRING=y
CONFIG_SYSTEM_TRUSTED_KEYS="bunix/verity.crt"

# Hardening, at little cost:
# - lockdown, "integrity" mode, always: the kernel refuses what would let
#   root change the running kernel (unsigned kexec, /dev/mem, raw I/O
#   ports, hibernation images)
# - Yama: a process can only ptrace its own descendants
# - Landlock: unprivileged sandboxing, for programs that use it
# - no SELinux: nothing on bunix uses it
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_INTEGRITY=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LANDLOCK=y
# CONFIG_SECURITY_SELINUX is not set
CONFIG_LSM="landlock,lockdown,yama"
# - memory: copies to and from user space checked against object bounds,
#   string functions checked at compile time, the slab freelist and page
#   allocator randomised and hardened, new allocations zeroed, a random
#   kernel stack offset per system call
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
CONFIG_LIST_HARDENED=y
CONFIG_IO_STRICT_DEVMEM=y
# - BPF (systemd's per-service firewalls and device rules) compiled, not
#   interpreted: faster, and the interpreter, a known gadget, is left out
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y

# BPF beyond systemd's own use, on network traffic: tc's bpf classifier
# and action on the clsact qdisc (sch_ingress), and AF_XDP sockets
CONFIG_NET_SCHED=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_ACT_BPF=y
CONFIG_XDP_SOCKETS=y

# Virtual machines' and tunnels' network devices (/dev/net/tun)
CONFIG_TUN=y

# Power: Intel's own idle driver, which knows each CPU's deeper C-states;
# and the NVMe drive's temperature
CONFIG_INTEL_IDLE=y
CONFIG_HWMON=y
CONFIG_NVME_HWMON=y

# The kernel image zstd-compressed, not gzip: smaller (the firmware reads
# and hashes every byte of the kernel image before it starts) and quicker
# to unpack
CONFIG_KERNEL_ZSTD=y
# Symbols for functions only, not for every variable
# CONFIG_KALLSYMS_ALL is not set
# No IPv6-in-IPv4 tunnels (SIT): nothing here uses them
# CONFIG_IPV6_SIT is not set
