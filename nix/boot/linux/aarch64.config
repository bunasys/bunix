# What bunix's kernel has on top of arm64's defconfig and the source's
# asahi.config.  Every line here must be in the final configuration, or
# the build fails (linux.sh).

# 16K pages: what Apple Silicon's own page size is, and what its GPU and
# storage drivers assume.  Programs that guess 4K break here, in the VM,
# before they break on the Mac.
CONFIG_ARM64_16K_PAGES=y

# The file system the kernel keeps its devices in, which systemd mounts
# on /dev.
CONFIG_DEVTMPFS=y

# /usr read-only and checked: the file system its image is made in, with
# compression, and the device mapper's check of every block read against
# the image's hash (docs/nix-usr-system.md, "Where this is going").  And
# what lays an extension's /usr over the system's.  None can be a module:
# modules are in /usr.
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
CONFIG_OVERLAY_FS=y

# The console's letters, twice the size, beside the usual ones.  The
# kernel chooses between the fonts it has by the size of the screen: on a
# Mac's, 2560 dots wide, the usual font gives 320 columns of letters too
# small to read, and this one 160.  A small screen keeps the small font.
# (fbcon=font:VGA8x16 on the command line asks for the small one anyway.)
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y

# asahi.config asks for Rust; here so that the build fails if the Rust
# compiler or bindgen is not found, where otherwise the Rust drivers would
# quietly be left out.
CONFIG_RUST=y

# No lockdown, and no signed modules whatever else asks for them: to sign
# them the kernel makes a new key in every build.  The image would differ
# from build to build, and hold a certificate nobody has the key of.
# CONFIG_SECURITY_LOCKDOWN_LSM is not set
# CONFIG_MODULE_SIG is not set

# Only the kernel image is built, and bunix loads no modules yet.  What a
# Mac needs to reach its disk, the network, a keyboard and a display is a
# module in asahi.config; here it is in the image.

# the disk
CONFIG_NVME_APPLE=y
CONFIG_APPLE_SART=y

# Ethernet: Broadcom's on most Macs, Aquantia's where 10 Gbit was ordered
CONFIG_TIGON3=y
CONFIG_NET_VENDOR_AQUANTIA=y
CONFIG_AQTION=y

# pins, buses and the system controller that the drivers above and below
# are switched on through
CONFIG_PINCTRL_APPLE_GPIO=y
CONFIG_I2C_APPLE=y
CONFIG_SPI_APPLE=y
CONFIG_GPIO_MACSMC=y
CONFIG_POWER_RESET_MACSMC=y
CONFIG_NVMEM_APPLE_EFUSES=y

# USB, for a keyboard or as the network below: the controller, the port's
# own signal hardware, and the chip that says what is plugged in
CONFIG_TYPEC=y
CONFIG_TYPEC_TPS6598X=y
CONFIG_PHY_APPLE_ATC=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_APPLE=y
CONFIG_HID_APPLE=y

# an M1 laptop's own keyboard, which is on SPI and not on USB
CONFIG_SPI_HID_APPLE_CORE=y
CONFIG_SPI_HID_APPLE_OF=y

# A link over a USB cable to another computer, which is to see this one
# as a serial port and a network adapter: for a way in before Wi-Fi is
# set up, and on a Mac without Ethernet.  Put together by
# /usr/lib/bunix/usb-link (images/system/), run by hand, from these
# parts.  Not working on a Mac yet (docs/nix-usr-system.md, "On a Mac").
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y

# Wi-Fi: Broadcom's chip on PCIe.  The radio switch (RFKILL) is a module by
# default, and Wi-Fi built in could then not use it.
#
# The chip's firmware is Apple's, and each Mac has its own in its macOS:
# it is not a package and not in the image.  Built in, the driver asks for
# it once, when the kernel starts, so it has to be in the initramfs by
# then: whoever boots a Mac adds an archive of that Mac's firmware after
# the image, and names its directory with firmware_class.path=.  Without
# it there is no wlan0.
CONFIG_RFKILL=y
CONFIG_CFG80211=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_PCIE=y

# What iwd asks of the kernel: it has no cryptography of its own, and uses
# the kernel's through sockets and keys.  All of its list, though the
# configurations above already have most: without one of the first eight
# it does not start.
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_MD4=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_DES=y
CONFIG_KEYS=y
CONFIG_KEY_DH_OPERATIONS=y
CONFIG_ASYMMETRIC_KEY_TYPE=y
CONFIG_ASYMMETRIC_PUBLIC_KEY_SUBTYPE=y
CONFIG_X509_CERTIFICATE_PARSER=y
CONFIG_PKCS7_MESSAGE_PARSER=y
CONFIG_PKCS8_PRIVATE_KEY_PARSER=y

# A laptop's lid and power button, which are the system controller's to
# report: systemd suspends when the lid closes, and the button is what
# wakes the machine.
CONFIG_INPUT_MACSMC_INPUT=y

# a display on a USB-C port: the display controller, and what routes its
# signal to the port.  (The boot loader's picture is on HDMI only.)
# The backlight class and sound are modules by default, and the
# controller's driver, built in, could then not use either: it would be
# left out, or be without sound.
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_DRM_APPLE=y
CONFIG_DRM_APPLE_AUDIO=y
CONFIG_MUX_APPLE_DPXBAR=y
CONFIG_PHY_APPLE_DPTX=y

# processor speed: without it the cores stay as slow as they booted
CONFIG_ARM_APPLE_SOC_CPUFREQ=y
