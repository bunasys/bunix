# The build VM (tools/build-vm/README.md): a Firecracker microVM that keeps
# its disk, with BuildStream's cache on it.  It has the runners' network
# (fc-runner.nft): the internet and nothing else; this machine reaches it
# at 172.16.0.250 over SSH.
#
# Addresses as fc-runner-vm's scheme, as instance 62: the host 172.16.0.249
# on fc-tap62, the VM 172.16.0.250 (from its MAC, by fcnet).
[Unit]
Description=Firecracker build VM
After=network-online.target fc-runner-network.service
Wants=network-online.target
Requires=fc-runner-network.service

[Service]
User=fc-build
Group=fc-build
ExecStartPre=+/bin/sh -c 'ip link del fc-tap62 2> /dev/null; \
  ip tuntap add dev fc-tap62 mode tap user fc-build && \
  ip addr add 172.16.0.249/30 dev fc-tap62 && ip link set fc-tap62 up'
ExecStartPre=/bin/rm -f /var/lib/fc-build/firecracker.socket
ExecStart=/usr/bin/firecracker --api-sock /var/lib/fc-build/firecracker.socket \
  --config-file /var/lib/fc-build/vm.json
# Ctrl-Alt-Del shuts the guest down cleanly (its disk holds the cache), which
# ends Firecracker
ExecStop=/bin/sh -c 'curl -s --unix-socket /var/lib/fc-build/firecracker.socket \
  -X PUT http://localhost/actions -H "Content-Type: application/json" \
  -d "{\\"action_type\\": \\"SendCtrlAltDel\\"}"; \
  while kill -0 $MAINPID 2> /dev/null; do sleep 1; done'
ExecStopPost=+/bin/sh -c 'ip link del fc-tap62 2> /dev/null || true'
Restart=on-failure
RestartSec=30
TimeoutStopSec=120

ProtectSystem=strict
ReadWritePaths=/var/lib/fc-build
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
DevicePolicy=closed
DeviceAllow=/dev/kvm rw
DeviceAllow=/dev/net/tun rw

[Install]
WantedBy=multi-user.target
