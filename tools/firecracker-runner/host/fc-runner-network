#!/bin/sh
# Instance <n>'s network: tap device fc-tap<n>, owned by fc-runner, with
# the host's end of 172.16.0.<4n>/30; forwarding, and NAT for all instances
# out of this machine.  The forward rules, which also keep the VMs off the
# home network, are in /etc/nftables.d/forward/fc-runner.nft, part of
# bunix's firewall.
set -e
action=$1
index=$2
tap=fc-tap$index
host_address=172.16.0.$((index * 4 + 1))
case $action in
  up)
    ip link del "$tap" 2> /dev/null || true
    ip tuntap add dev "$tap" mode tap user fc-runner
    ip addr add "$host_address/30" dev "$tap"
    ip link set "$tap" up
    sysctl -q -w net.ipv4.ip_forward=1
    nft -f - <<'NFT'
table ip fc-runner {
	chain postrouting {
		type nat hook postrouting priority srcnat;
	}
}
flush chain ip fc-runner postrouting
add rule ip fc-runner postrouting ip saddr 172.16.0.0/24 oifname != "fc-tap*" masquerade
NFT
    ;;
  down)
    ip link del "$tap" 2> /dev/null || true
    ;;
esac
