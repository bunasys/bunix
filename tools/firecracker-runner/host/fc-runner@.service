# GitHub Actions jobs in Firecracker microVMs (tools/firecracker-runner/
# README.md).  Each run of this service is one VM for one job: the VM
# reboots when its job is done, which ends Firecracker, and the service
# starts again with a fresh disk and a new registration (fc-runner-vm).
#
# Firecracker runs as fc-runner-<n>, a user of this instance alone, and
# sees only this instance's directory: a VM that broke out of it would not
# reach the GitHub App's key or another instance's VM.
[Unit]
Description=GitHub Actions jobs in Firecracker microVMs, instance %i
After=network-online.target nftables.service fc-runner-network.service
Wants=network-online.target
Requires=fc-runner-network.service

[Service]
User=fc-runner-%i
Group=fc-runner-%i
ExecStartPre=+/var/lib/fc-runner/bin/fc-runner-vm prepare %i
ExecStart=/usr/bin/firecracker --api-sock /var/lib/fc-runner/%i/firecracker.socket \
  --config-file /var/lib/fc-runner/%i/vm.json
ExecStop=+/var/lib/fc-runner/bin/fc-runner-vm stop %i $MAINPID
ExecStopPost=+/var/lib/fc-runner/bin/fc-runner-vm cleanup %i
Restart=always
RestartSec=10
TimeoutStopSec=90

# The sandbox applies to every command, the + ones too: the instance's
# directory is systemd's to make, and /run/fc-runner exists only once
# prepare has run
ProtectSystem=strict
StateDirectory=fc-runner/%i
StateDirectoryMode=0700
InaccessiblePaths=-/etc/fc-runner -/run/fc-runner
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
DevicePolicy=closed
DeviceAllow=/dev/kvm rw
DeviceAllow=/dev/net/tun rw

[Install]
WantedBy=multi-user.target
