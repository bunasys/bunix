#!/bin/sh
# Instance <n>: boots a VM from a fresh copy of the image, waits until it is
# gone (the guest reboots after its job, which ends Firecracker), and starts
# over: nothing a job leaves on the disk reaches the next one.
set -e
index=$1
dir=/var/lib/fc-runner/$index
socket=$dir/firecracker.socket
# fcnet in the guest takes its address from the MAC's last four bytes
guest_last=$((index * 4 + 2))
mac=$(printf '06:00:AC:10:00:%02X' "$guest_last")

cat > "$dir/vm.json" <<JSON
{
  "boot-source": {
    "kernel_image_path": "/var/lib/fc-runner/vmlinux",
    "boot_args": "console=ttyS0 reboot=k panic=1 pci=off quiet"
  },
  "drives": [
    { "drive_id": "rootfs", "path_on_host": "$dir/rootfs.ext4",
      "is_root_device": true, "is_read_only": false },
    { "drive_id": "config", "path_on_host": "$dir/config.ext4",
      "is_root_device": false, "is_read_only": true }
  ],
  "machine-config": { "vcpu_count": 4, "mem_size_mib": 12288 },
  "network-interfaces": [
    { "iface_id": "eth0", "guest_mac": "$mac", "host_dev_name": "fc-tap$index" }
  ]
}
JSON

# On stop (systemd's SIGTERM), the VM shuts down instead of being killed:
# Ctrl-Alt-Del reboots the guest, which stops the runner first, and a
# runner that stops tells GitHub its session is over.  A killed one leaves
# the session behind, and GitHub gives the next VM's runner no job until it
# expires, minutes later.
firecracker_pid=""
shut_down_vm() {
  if [ -n "$firecracker_pid" ]; then
    curl -s --unix-socket "$socket" -X PUT http://localhost/actions \
      -H 'Content-Type: application/json' -d '{"action_type": "SendCtrlAltDel"}' || true
    wait "$firecracker_pid" || true
  fi
  exit 0
}
trap shut_down_vm TERM INT

while true; do
  rm -f "$dir/rootfs.ext4" "$socket"
  cp --sparse=always /var/lib/fc-runner/rootfs.ext4 "$dir/rootfs.ext4"
  # (in the background, so the trap runs while the VM does)
  firecracker --api-sock "$socket" --config-file "$dir/vm.json" &
  firecracker_pid=$!
  wait "$firecracker_pid" || echo "firecracker exited with $?"
  firecracker_pid=""
  sleep 2
done
