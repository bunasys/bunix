# The runner, for this VM's one job.  Its registration (runner-registration)
# is a just-in-time one: GitHub gives it one job and removes it afterwards.
# When the runner stops, for any reason, the VM reboots, which ends
# Firecracker; the host then starts a clean VM with a new registration.
[Unit]
Description=GitHub Actions runner
After=runner-net.service
Requires=runner-net.service

[Service]
User=runner
WorkingDirectory=/home/runner/actions-runner
ExecStartPre=+/usr/local/bin/runner-registration
ExecStart=/bin/sh -c 'exec ./run.sh --jitconfig "$$(cat /run/runner-jitconfig)"'
ExecStopPost=+/usr/bin/systemctl reboot
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
