# One job per VM: the runner's registration comes from the read-only
# config drive (/dev/vdb); --once makes it take one job, report it and
# exit, and when the runner stops for any reason the VM reboots, which ends
# Firecracker; the host then boots a clean copy.  (--once, not
# --ephemeral: an ephemeral runner removes its registration, and a new one
# would need an admin token on the host.)
[Unit]
Description=GitHub Actions runner
After=runner-net.service
Requires=runner-net.service

[Service]
User=runner
WorkingDirectory=/home/runner/actions-runner
ExecStartPre=+/usr/local/bin/runner-config
ExecStart=/home/runner/actions-runner/run.sh --once
ExecStopPost=+/usr/bin/systemctl reboot
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
