[Unit]
Description=Shared BuildStream cache: artifact index (bunix tools/cache-server)
RequiresMountsFor=/srv/ci/bst-cache
Wants=bb-storage.service
After=bb-storage.service

[Service]
User=bst-cache
ExecStart=/usr/local/bin/bb_remote_asset /etc/bst-cache/asset.jsonnet
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/srv/ci/bst-cache

[Install]
WantedBy=multi-user.target
