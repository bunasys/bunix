kind: manual
description: |
  Crubit's cc_bindings_from_rs and support library -- only for building
  Hudhud (docs/browser.md).  Chromium makes C++ bindings for some of
  its Rust code (Blink's fonts, QR codes, CBOR, ...) with it.  Built
  against Chromium's Rust (base/chromium-rust.bst), since it runs inside
  that rustc, and installed into that toolchain, where Chromium looks
  for it (third_party/rust-toolchain/bin and lib/third_party/crubit): the
  layout tools/rust/build_crubit.py gives Chromium's own package.

  The revision Chromium 157 pins (tools/rust/update_rust.py).  Crubit's
  other tool, rs_bindings_from_cc (Rust bindings for C++, with Abseil,
  Protobuf and clang's libraries), Chromium does not use by default
  (enable_rust_api_from_cpp), so it is not built.

(@): include/system.yml

build-depends:
- bootstrap/build-env.bst
# cargo: the system's; rustc: Chromium's (below)
- bootstrap/rust.bst

# the tool loads rustc's own library (librustc_driver) from this toolchain
depends:
- base/chromium-rust.bst

variables:
  rust-prefix: "%{prefix}/lib/chromium-rust"

environment:
  RUSTC: "%{rust-prefix}/bin/rustc"

config:
  build-commands:
  # librustc_driver is next to the tool's directory, in ../lib, as for
  # rustc itself
  - |
    RUSTFLAGS='-Clink-args=-Wl,-rpath,$ORIGIN/../lib' \
      cargo build --release --locked --offline -p cc_bindings_from_rs --bin cc_bindings_from_rs

  install-commands:
  - |
    mkdir -p %{install-root}%{rust-prefix}/bin
    install -m 755 target/release/cc_bindings_from_rs %{install-root}%{rust-prefix}/bin/
    crubit=%{install-root}%{rust-prefix}/lib/third_party/crubit
    mkdir -p $crubit
    cp -r BUILD.gn LICENSE crubit.gni support $crubit/
  - |
    tool=%{install-root}%{rust-prefix}/bin/cc_bindings_from_rs
    # it finds librustc_driver through its RUNPATH once installed ...
    readelf -d $tool | grep 'R.*PATH.*\$ORIGIN/\.\./lib'
    # ... and here, before that, through the staged toolchain
    LD_LIBRARY_PATH=%{rust-prefix}/lib $tool --help > /dev/null

