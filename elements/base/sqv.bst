# Botan (base/botan.bst) for the cryptography, linked statically, with the
# C++ runtime it needs: bunix ships no libstdc++.so.
environment:
  RUSTFLAGS: -C link-arg=-l:libstdc++.a

variables:
  cargo-install-local: --no-default-features --features crypto-botan
