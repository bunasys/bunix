+// Hudhud: password managers and other desktop apps register their
+// browser helpers for Google Chrome, not for Hudhud, so Chrome's folders
+// are looked in last.  A helper's manifest still names the extensions
+// allowed to use it (allowed_origins).
+base::FilePath FindManifestForChrome(const std::string& host_name,
+                                     bool allow_user_level_hosts) {
+  std::vector<base::FilePath> dirs;
+#if BUILDFLAG(IS_MAC)
+  base::FilePath app_support;
+  if (allow_user_level_hosts &&
+      base::PathService::Get(base::DIR_APP_DATA, &app_support)) {
+    dirs.push_back(app_support.Append("Google/Chrome/NativeMessagingHosts"));
+  }
+  dirs.push_back(base::FilePath("/Library/Google/Chrome/NativeMessagingHosts"));
+#else
+  base::FilePath home;
+  if (allow_user_level_hosts &&
+      base::PathService::Get(base::DIR_HOME, &home)) {
+    dirs.push_back(home.Append(".config/google-chrome/NativeMessagingHosts"));
+  }
+  dirs.push_back(base::FilePath("/etc/opt/chrome/native-messaging-hosts"));
+#endif
+  for (const base::FilePath& dir : dirs) {
+    base::FilePath path = dir.Append(host_name + ".json");
+    if (base::PathExists(path)) {
+      return path;
+    }
+  }
+  return base::FilePath();
+}
