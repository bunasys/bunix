[Desktop Entry]
Type=Application
Name=Hudhud
Name[ar]=هدهد
GenericName=Web Browser
GenericName[ar]=متصفح الويب
Comment=Browse the web, without ads and trackers
Comment[ar]=تصفح الويب بلا إعلانات ولا أدوات تتبع
Exec=hudhud %U
Icon=hudhud
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
StartupNotify=true
StartupWMClass=hudhud
Actions=new-window;new-private-window;

[Desktop Action new-window]
Name=New Window
Name[ar]=نافذة جديدة
Exec=hudhud

[Desktop Action new-private-window]
Name=New Incognito Window
Name[ar]=نافذة تصفح متخفٍ جديدة
Exec=hudhud --incognito
