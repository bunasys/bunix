[Desktop Entry]
Type=Application
Name=Buna Browser
GenericName=Web Browser
GenericName[ar]=متصفح الويب
Comment=Browse the web, without ads and trackers
Comment[ar]=تصفح الويب بلا إعلانات ولا أدوات تتبع
Exec=buna-browser %U
Icon=buna-browser
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
StartupNotify=true
StartupWMClass=buna-browser
Actions=new-window;new-private-window;

[Desktop Action new-window]
Name=New Window
Name[ar]=نافذة جديدة
Exec=buna-browser

[Desktop Action new-private-window]
Name=New Incognito Window
Name[ar]=نافذة تصفح متخفٍ جديدة
Exec=buna-browser --incognito
