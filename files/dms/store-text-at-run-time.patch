DMS knows programs a Nix profile installs by the text "/nix/store" in
their paths, and so carries that text in its program.  bunix's package
check refuses a package with that text in it, as it would a reference to
the store the package was built in.  Here the text is put together when
DMS runs, from two parts: what DMS does is unchanged.

--- a/core/cmd/dms/commands_doctor.go
+++ b/core/cmd/dms/commands_doctor.go
@@ -820,7 +820,7 @@
 	if doctorVerbose {
 		installType := "Unknown"
 		switch {
-		case strings.Contains(dmsPath, "/nix/store"):
+		case strings.Contains(dmsPath, filepath.Join("/nix", "store")):
 			installType = "Nix store"
 		case strings.Contains(dmsPath, ".local/share") || strings.Contains(dmsPath, "/usr/share"):
 			installType = "System package"
--- a/core/internal/server/sysupdate/shell.go
+++ b/core/internal/server/sysupdate/shell.go
@@ -80,7 +80,7 @@
 	info := unprobedShell(running)
 	path := dmsBinaryPath()
 
-	if strings.HasPrefix(path, "/nix/store/") {
+	if strings.HasPrefix(path, filepath.Join("/nix", "store")+"/") {
 		info.InstallMethod = InstallNix
 	} else if method, name, version := packageOwner(ctx, path); method != "" {
 		info.InstallMethod = method
