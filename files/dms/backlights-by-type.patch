+// The kernel's own order of preference among a machine's backlights, as
+// systemd and GNOME use it: the firmware's control of the screen, then
+// the platform's, then a driver's raw one.  The interface takes the first
+// backlight as the screen's.  By name alone, a MacBook Pro's Touch Bar
+// (raw, "228600000.dsi.0") came before its screen (platform,
+// "apple-panel-bl").
+func backlightTypeRank(backlightType string) int {
+	switch backlightType {
+	case "firmware":
