# bunix x86_64: additions to the kernel's own x86_64_defconfig for booting
# real PCs (and QEMU) from the ISO.  elements/system/linux.bst fails if any
# line here does not survive `make olddefconfig`.
#
# What every machine needs to boot (disks, file systems, the console, wired
# network) is built in; the initrd carries only the GPU modules (early
# KMS, system/initrd.bst).  Drivers for
# hardware only some machines have -- GPUs, Wi-Fi, Bluetooth, touch -- and
# every driver that needs firmware are modules: udev loads the ones the
# machine has, from /usr, where the firmware is too.

# Loadable modules, zstd-compressed.  Each is signed at build time with a
# key the build generates and throws away (certs/signing_key.pem), so
# nothing but this build's modules ever loads, Secure Boot or not.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA256=y
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_ZSTD=y

# the whole rootfs is the initramfs, zstd-compressed
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# what systemd expects of a kernel
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_FHANDLE=y
CONFIG_AUTOFS_FS=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_INOTIFY_USER=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y

# UEFI
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y

# console: VGA text, the firmware framebuffer, and serial
CONFIG_VGA_CONSOLE=y
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
# fbcon sits on DRM's fbdev emulation
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_CLIENT_DEFAULT_FBDEV=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# The boot splash: fbcon leaves the screen alone (and the boot stub's logo on
# it) until text is actually written to the console -- with "quiet", only
# when something goes wrong; Plymouth draws over the same picture.  No
# penguin either.
# (it needs the fbdev layer itself, without its firmware framebuffer
# drivers: simpledrm has the screen)
CONFIG_FB=y
# CONFIG_FB_EFI is not set
# CONFIG_FB_VESA is not set
CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=y
# CONFIG_LOGO is not set
CONFIG_SERIAL_8250=y

# GPUs: Intel (i915 up to Alder Lake, xe after), AMD (amdgpu; radeon for
# GPUs older than GCN).  When one loads it takes the screen over from
# simpledrm and sets the panel's own resolution.  NVIDIA's open driver
# (nouveau) needs NVIDIA's large firmware for recent cards: not yet.
CONFIG_DRM_I915=m
CONFIG_DRM_XE=m
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMDGPU_SI=y
CONFIG_DRM_AMDGPU_CIK=y
CONFIG_DRM_AMD_DC=y
CONFIG_DRM_RADEON=m
# virtual machines' GPUs (QEMU's standard VGA and virtio-gpu): the same
# hand-over from simpledrm, testable without the hardware
CONFIG_DRM_BOCHS=m
CONFIG_DRM_VIRTIO_GPU=m
CONFIG_SERIAL_8250_CONSOLE=y

# keyboards: PS/2 and USB
CONFIG_KEYBOARD_ATKBD=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y

# Touch screens, touchpads and pens.  libinput reads them through evdev.
# Laptops wire them over I2C, which on Intel needs the LPSS I2C controllers
# and the GPIO controller of the platform (pinctrl) for their interrupt
# lines; those are built in, the devices' drivers are modules.
CONFIG_INPUT_EVDEV=y
CONFIG_HID_MULTITOUCH=m
CONFIG_HID_WACOM=m
CONFIG_I2C_HID_ACPI=m
CONFIG_INTEL_ISH_HID=m
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_GOODIX=m
CONFIG_TOUCHSCREEN_ELAN=m
CONFIG_MOUSE_PS2=y
CONFIG_I2C=y
CONFIG_GPIOLIB=y
CONFIG_PINCTRL=y
CONFIG_COMMON_CLK=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_I2C_DESIGNWARE_PCI=y
CONFIG_MFD_INTEL_LPSS_ACPI=y
CONFIG_MFD_INTEL_LPSS_PCI=y
CONFIG_PINCTRL_INTEL_PLATFORM=y
CONFIG_PINCTRL_SUNRISEPOINT=y
CONFIG_PINCTRL_CANNONLAKE=y
CONFIG_PINCTRL_ICELAKE=y
CONFIG_PINCTRL_JASPERLAKE=y
CONFIG_PINCTRL_TIGERLAKE=y
CONFIG_PINCTRL_ALDERLAKE=y
CONFIG_PINCTRL_METEORLAKE=y

# Input devices made by programs, not hardware: Surface touch screens
# (iptsd), key remappers, Steam's controllers, and the fake touch screen
# that tests buna-login's keyboard.  Built in, so /dev/uinput is there
# without anything loading it first.  Only root can open it for now: no
# udev rule gives it to the logged-in user, since whoever has it can type
# into every program on the seat.
CONFIG_INPUT_UINPUT=y

# networking: AF_PACKET is what DHCP clients use
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y

# wired NICs found in common PCs, laptops and USB dongles (as modules the
# ones that load firmware: Realtek's r8169, Broadcom's tg3 and bnx2)
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_IGC=y
CONFIG_IXGBE=y
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169=m
CONFIG_8139CP=y
CONFIG_8139TOO=y
CONFIG_NET_VENDOR_BROADCOM=y
CONFIG_TIGON3=m
CONFIG_BNX2=m
CONFIG_NET_VENDOR_ATHEROS=y
CONFIG_ALX=y
CONFIG_ATL1C=y
CONFIG_NET_VENDOR_MARVELL=y
CONFIG_SKGE=y
CONFIG_SKY2=y
CONFIG_NET_VENDOR_AQUANTIA=y
CONFIG_AQTION=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_RTL8152=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y

# QEMU / KVM guests, for testing the ISO before writing it to a USB stick
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM_VIRTIO=y

# local disks, so they can be mounted from the live system
CONFIG_BLK_DEV_NVME=y
CONFIG_SATA_AHCI=y
CONFIG_USB_STORAGE=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y

# set the system clock from the RTC, so TLS certificates validate before
# timesyncd has synchronised
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_CMOS=y

# Wi-Fi: the 802.11 stack and drivers for the chips in most laptops, all
# modules, next to their firmware in /usr/lib/firmware (system/firmware.bst,
# zstd-compressed).  cfg80211 is a module too: it loads the regulatory
# database (base/wireless-regdb.bst) the same way.
CONFIG_WIRELESS=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_RFKILL=y
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_WLAN=y
# Intel: dvm = older chips, mvm = 7000..AX2xx, mld = BE2xx (Wi-Fi 7)
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_IWLWIFI=m
CONFIG_IWLDVM=m
CONFIG_IWLMVM=m
CONFIG_IWLMLD=m
# Qualcomm / Atheros
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH9K=m
CONFIG_ATH9K_PCI=y
CONFIG_ATH10K=m
CONFIG_ATH10K_PCI=m
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
CONFIG_ATH12K=m
# Realtek, PCIe and USB
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTW88=m
CONFIG_RTW88_8822BE=m
CONFIG_RTW88_8822CE=m
CONFIG_RTW88_8821CE=m
CONFIG_RTW88_8723DE=m
CONFIG_RTW88_8822BU=m
CONFIG_RTW88_8822CU=m
CONFIG_RTW88_8821CU=m
CONFIG_RTW89=m
CONFIG_RTW89_8852AE=m
CONFIG_RTW89_8852BE=m
CONFIG_RTW89_8852CE=m
CONFIG_RTW89_8922AE=m
# MediaTek (mt7921e also drives the MT7922), PCIe and USB
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7921E=m
CONFIG_MT7921U=m
CONFIG_MT7925E=m
# Broadcom
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_PCIE=y

# Sound: the HD Audio controller as a module (built in, it would start
# before the GPU's driver, whose HDMI codec it shares), and the drivers for
# the codecs on it: without them the controller finds nothing to drive
# ("Cannot probe codecs, giving up").  The defconfig has none.  Each family
# selects all its chips (ALC2xx..ALC8xx; Intel, AMD, NVIDIA HDMI).
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_HDA_CODEC_HDMI=m
CONFIG_SND_HDA_CODEC_CONEXANT=m
CONFIG_SND_HDA_CODEC_CIRRUS=m
CONFIG_SND_HDA_CODEC_ANALOG=m
CONFIG_SND_HDA_CODEC_SIGMATEL=m
CONFIG_SND_HDA_CODEC_VIA=m
CONFIG_SND_HDA_CODEC_CA0132=m

# Sandboxes: user namespaces (bubblewrap -- BuildStream's builds, Flatpak,
# browsers' sandboxes) and FUSE (BuildStream's buildbox-fuse)
CONFIG_USER_NS=y
CONFIG_FUSE_FS=y

# Virtual machines on this machine (Firecracker, QEMU): KVM for /dev/kvm,
# tun for the VMs' TAP network devices, and the bridge that joins several
# VMs' TAPs into one network.  Modules: the CPU's KVM module loads at boot
# (udev matches the vmx/svm CPU flag), the bridge when one is created;
# tun at boot where something needs it, as /dev/net/tun appears only once
# it is loaded (tools/firecracker-runner/install.sh).
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=m
CONFIG_KVM_INTEL=m
CONFIG_KVM_AMD=m
CONFIG_TUN=m
CONFIG_BRIDGE=m

# WireGuard VPN tunnels, set up by systemd-networkd (Kind=wireguard); the
# module loads when the first one is created
CONFIG_WIREGUARD=m

# The firewall (files/rootfs/usr/lib/bunix/firewall.nft): nftables, with
# connection tracking for "replies to this machine's own connections"
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_LIMIT=y
# ...and NAT, so virtual machines behind a bridge reach the network
# through this machine's address (masquerading)
CONFIG_NF_NAT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y

# Swap in memory, compressed with zstd: zram (files/rootfs, zram-swap)
CONFIG_SWAP=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y

# The TPM (discrete chips and the firmware TPMs of Intel PTT and AMD fTPM,
# through TIS and CRB): systemd measures the extension images' verity root
# hashes into it.  Built in, so the initrd has it without modules.
CONFIG_TCG_TPM=y
CONFIG_TCG_TIS=y
CONFIG_TCG_CRB=y
# the firmware's TPM event log is read through securityfs
# (/sys/kernel/security/tpm0/binary_bios_measurements); without it systemd
# reports the TPM as "firmware unavailable" and measures nothing
CONFIG_SECURITYFS=y

# Bluetooth: the stack and the USB and PCIe adapters built into laptops
# (Intel, Realtek, MediaTek, Broadcom, Qualcomm); the userspace (BlueZ)
# comes later
CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=m
CONFIG_BT_HIDP=m
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_BT_HCIBTUSB_MTK=y
CONFIG_BT_INTEL_PCIE=m

# what iwd needs from the kernel: hashes and ciphers through AF_ALG, and the
# keyring's DH and certificate parsers (for WPA3/SAE and WPA-Enterprise)
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_MD4=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_DES=y
CONFIG_KEYS=y
CONFIG_KEY_DH_OPERATIONS=y
CONFIG_ASYMMETRIC_KEY_TYPE=y
CONFIG_ASYMMETRIC_PUBLIC_KEY_SUBTYPE=y
CONFIG_X509_CERTIFICATE_PARSER=y
CONFIG_PKCS7_MESSAGE_PARSER=y
CONFIG_PKCS8_PRIVATE_KEY_PARSER=y

# System extension images (docs/updates.md): overlayfs lays them over /usr,
# erofs is their file system, dm-verity checks every block as it is read.
# The kernel accepts an image only if its root hash is signed by a key in
# the system keyring -- the bunix image signing certificate, built in.
CONFIG_OVERLAY_FS=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_ZIP_LZMA=y
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
CONFIG_DM_VERITY_VERIFY_ROOTHASH_SIG=y
CONFIG_SYSTEM_TRUSTED_KEYRING=y
CONFIG_SYSTEM_TRUSTED_KEYS="bunix/verity.crt"

# USB disks over UAS (an installed system may live on one)
CONFIG_USB_UAS=y

# Hardening, at little cost:
# - lockdown, "integrity" mode, always (mainline cannot tie it to Secure
#   Boot; that is a distribution patch): the kernel refuses what would let
#   root change the running kernel -- unsigned kexec, /dev/mem, raw I/O
#   ports, hibernation images, unsigned modules
# - Yama: a process can only ptrace its own descendants
# - Landlock: unprivileged sandboxing, for programs that use it
# - no SELinux: nothing on bunix uses it, and a security module that does
#   nothing is only attack surface
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_INTEGRITY=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LANDLOCK=y
# CONFIG_SECURITY_SELINUX is not set
# - BPF LSM: security policies as BPF programs; only root loads them
#   (unprivileged BPF is off)
CONFIG_BPF_LSM=y
CONFIG_LSM="landlock,lockdown,yama,bpf"
# - memory: copies to and from user space checked against object bounds,
#   string functions checked at compile time, the slab freelist and page
#   allocator randomised and hardened, new allocations zeroed, a random
#   kernel stack offset per system call
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
CONFIG_LIST_HARDENED=y
CONFIG_IO_STRICT_DEVMEM=y
# - BPF (systemd's per-service firewalls and device rules) compiled, not
#   interpreted: faster, and the interpreter, a known gadget, is left out
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y

# BPF beyond systemd's own use, for tracing and networking tools (bpftrace,
# libbpf's tools, Cilium-style networking):
# - BTF, the kernel's types, at /sys/kernel/btf/vmlinux and per module:
#   BPF programs built once run on any kernel (CO-RE).  pahole makes it
#   from DWARF, which only exists during the build: bzImage and the
#   stripped modules keep the BTF, not the DWARF.
# - the function tracer, for fentry/fexit programs (faster than kprobes)
# - BPF on network traffic: tc's bpf classifier and action on the clsact
#   qdisc (sch_ingress), and AF_XDP sockets

# CONFIG_DEBUG_INFO_NONE is not set
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y
CONFIG_FUNCTION_TRACER=y
CONFIG_NET_SCHED=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_SCH_INGRESS=m
CONFIG_NET_CLS_BPF=m
CONFIG_NET_ACT_BPF=m
CONFIG_XDP_SOCKETS=y

# Power: Intel's own idle driver, which knows each CPU's deeper C-states
# (acpi_idle only knows what the firmware lists)
CONFIG_INTEL_IDLE=y
# ...package and core power as the CPU measures it (RAPL, read by powertop
# and power-profile tools), and temperatures: per core (coretemp, AMD's
# k10temp) and the NVMe drive's own sensor
CONFIG_POWERCAP=y
CONFIG_INTEL_RAPL=m
CONFIG_HWMON=y
CONFIG_SENSORS_CORETEMP=m
CONFIG_SENSORS_K10TEMP=m
CONFIG_NVME_HWMON=y

# The kernel image zstd-compressed, not gzip: smaller (the firmware reads
# and hashes every byte of the UKI before it starts) and quicker to unpack
CONFIG_KERNEL_ZSTD=y
# Symbols for functions only, not for every variable: those are for
# kernel debugging, and tell an attacker where kernel data lives
# CONFIG_KALLSYMS_ALL is not set
# No IPv6-in-IPv4 tunnels (SIT): nothing here uses them, and the module
# creates a sit0 interface on every machine
# CONFIG_IPV6_SIT is not set
