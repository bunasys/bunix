#!/bin/bash
# bunix-install: install bunix from the live image onto a disk, next to what
# is already on it (Windows, say), into one of
#
#   - a stretch of free space (make it first: shrink Windows' C: in Disk
#     Management -- this tool does not resize file systems)
#   - an existing partition, which it deletes
#   - an earlier bunix or another Linux system, whose partitions it deletes
#     (a guess from the partition table, shown in full before anything is
#     deleted)
#   - a whole disk, which it erases
#
# Nothing outside the chosen space is written, except the disk's EFI system
# partition (ESP), where it adds the directory EFI/bunix/ (and, replacing a
# system, puts bunix's loader/loader.conf in place of the old one), and a
# firmware boot entry "bunix".  When the machine already boots Windows, Windows stays
# the default; pick bunix from the firmware's boot menu.  systemd-boot lists
# Windows too when the two share an ESP.
#
# The partitions it creates in the chosen space (UAPI Discoverable
# Partitions; docs/install.md):
#
#   ESP         only if the disk has none
#   XBOOTLDR    the kernel images (UKIs) -- a Windows ESP is too small
#   /usr slot A this release: data, dm-verity hashes, signature
#   /usr slot B empty, for the next update
#   root        ext4, the rest of the space
#
# bunix must sit on the same disk as the ESP it boots from: the initrd finds
# the root partition on that disk.  A disk without an ESP gets its own.
#
# On the root file system it also puts the person's account, an
# administrator through run0 (wheel), and, for a desktop, the `desktop`
# extension from the medium, turned on, so the first boot shows the login
# screen.  Root gets a locked password: nobody logs in as root, and the
# console asks for a login instead of opening root's shell.
#
# Questions are read from standard input, so a test can answer them (disk,
# place, desktop or console, host name, name, user name, password twice,
# confirmation; tools/boot-checks/install-*.txt answer them in this order):
#   printf '1\n2\n1\nsara-laptop\nSara\nsara\nsecret\nsecret\nyes\n' | bunix-install
set -euo pipefail
# so that a failed $(ask ...) inside a function stops the script too
shopt -s inherit_errexit

# Partition sizes in MiB.  The /usr slots must match system/disk.bst.
ESP_SIZE=512
BOOT_SIZE=1024
USR_SIZE=1024
# verity: the hash tree is 1/128 of /usr, 8 MiB at most -- twice that
USR_VERITY_SIZE=16
USR_SIGNATURE_SIZE=1
ROOT_MIN_SIZE=8192
USR_SLOT_SIZE=$((USR_SIZE + USR_VERITY_SIZE + USR_SIGNATURE_SIZE))
NEEDED_SIZE=$((BOOT_SIZE + 2 * USR_SLOT_SIZE + ROOT_MIN_SIZE))

# GPT partition types, x86-64
TYPE_ESP=c12a7328-f81f-11d2-ba4b-00a0c93ec93b
TYPE_XBOOTLDR=bc13c2ff-59e6-4262-a352-b275fd6f7172
TYPE_USR=8484680c-9521-48c6-9c11-b0720656f69e
TYPE_USR_VERITY=77ff5f63-e7b6-4633-acf4-1565b864c0e6
TYPE_USR_VERITY_SIG=e7bb33fb-06cf-4e81-8273-e543b413e2e2
TYPE_ROOT=4f68bce3-e8cd-4db1-96e7-fbcaf984b709

MiB=$((1024 * 1024))
WORK=/run/bunix-install
SECURE_BOOT_VAR=/sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c
# systemd-boot's default entry, when `bootctl set-default` chose one
LOADER_ENTRY_DEFAULT_VAR=/sys/firmware/efi/efivars/LoaderEntryDefault-4a67b082-0a4c-41cf-b6c7-440b29bb8c4f

die() { echo "bunix-install: $*" >&2; exit 1; }

ask() {
  local answer
  printf '%s ' "$1" >&2
  read -r answer || die "no answer"
  printf '%s\n' "$answer"
}

# Asks for a number from 1 to $2; prints it less one, an array index
ask_number() {
  local question=$1 count=$2
  local answer
  answer=$(ask "$question [1-$count]")
  [[ "$answer" =~ ^[0-9]+$ ]] || die "not a number: $answer"
  [ "$answer" -ge 1 ] && [ "$answer" -le "$count" ] || die "no such choice: $answer"
  echo $(( answer - 1 ))
}

# A password: not echoed on a terminal, and taken as typed, spaces at its
# ends too (IFS=)
ask_secret() {
  local answer
  printf '%s ' "$1" >&2
  IFS= read -rs answer || die "no answer"
  echo >&2
  printf '%s\n' "$answer"
}

new_uuid() { cat /proc/sys/kernel/random/uuid; }

# Whether a name is among the rest of the arguments
is_one_of() {
  local name=$1; shift
  local other
  for other in "$@"; do
    [ "$other" = "$name" ] && return 0
  done
  return 1
}

# A partition's device, once udev has created its link
device_of_partuuid() {
  local link=/dev/disk/by-partuuid/$1
  for _ in $(seq 50); do
    [ -e "$link" ] && { readlink -f "$link"; return; }
    udevadm settle
    sleep 0.2
  done
  die "partition $1 did not appear"
}

cleanup() {
  for dir in "$WORK"/esp "$WORK"/boot "$WORK"/root; do
    mountpoint -q "$dir" && umount "$dir"
  done
  return 0
}
trap cleanup EXIT

[ "$(id -u)" = 0 ] || die "run as root"
[ -d /sys/firmware/efi ] || die "this machine did not boot with UEFI; bunix boots with UEFI only"
# It is in every /usr, but installs only from the live image it booted
grep -qw bunix.live /proc/cmdline || die "bunix is installed already: bunix-install runs on the live system"

# The release to install comes from the boot medium (system/live.bst puts it
# in install/), the files the live system's own /usr is mounted from.  Its
# initrd mounted the medium already (files/live/usr/lib/bunix/live-usr) and
# left it mounted.
medium=/run/bunix/medium
mountpoint -q "$medium" || die "the boot medium is not mounted at $medium"
medium_device=$(readlink -f "$(findmnt -no SOURCE "$medium")")
files=$medium/install
mkdir -p "$WORK"/esp "$WORK"/boot "$WORK"/root
uki=$(ls "$files"/bunix_*.efi)
release=$(basename "$uki" .efi)
release=${release#bunix_}
usr_image=$(ls "$files"/bunix_"$release".usr-x86-64.*.raw)
verity_image=$(ls "$files"/bunix_"$release".usr-x86-64-verity.*.raw)
signature_image=$(ls "$files"/bunix_"$release".usr-x86-64-verity-sig.*.raw)
# The UKI's usrhash= finds slot A's partitions by these UUIDs
# (system/usr.bst).  The file names carry them without dashes.
uuid_in_name() {
  local hex
  hex=$(basename "$1" .raw | sed 's/.*\.//')
  echo "${hex:0:8}-${hex:8:4}-${hex:12:4}-${hex:16:4}-${hex:20:12}"
}

echo "bunix $release installer"
echo

# --- the disk -----------------------------------------------------------

# The medium itself, or the disk it is a partition of, is not a choice
# (walking up through any loop or device-mapper layers, as on a Ventoy stick)
medium_disk=$(lsblk -nslpo NAME,TYPE "$medium_device" | awk '$2 == "disk" { disk = $1 } END { print disk }')
medium_disk=${medium_disk:-$medium_device}
disks=()
while read -r name type; do
  [ "$type" = disk ] || continue
  [ "$name" = "$medium_disk" ] && continue
  # compressed swap in memory (zram-swap), not a disk to install to
  case $name in /dev/zram*) continue ;; esac
  disks+=("$name")
done < <(lsblk -ndpo NAME,TYPE)
[ ${#disks[@]} -gt 0 ] || die "no disk to install to"

echo "Disks:"
for i in "${!disks[@]}"; do
  printf '  %d) %s  %s  %s\n' $((i + 1)) "${disks[$i]}" \
    "$(lsblk -ndo SIZE "${disks[$i]}")" "$(lsblk -ndo MODEL "${disks[$i]}")"
done
# (asked on its own line: a failed answer then stops the script, which it
# would not inside the array index)
index=$(ask_number "Install to which disk?" ${#disks[@]})
disk=${disks[$index]}

# --- the place on it ----------------------------------------------------

# Each place is "kind start end partitions description": start and end in
# bytes, partitions those to delete, comma-separated (or "-").
sector_size=$(blockdev --getss "$disk")
places=()

# A partition's place on the disk, in bytes: "start end" (sysfs counts in
# 512-byte units, whatever the disk's sector size)
extent_of() {
  local sysfs
  sysfs=/sys/class/block/$(basename "$1")
  local start=$(( $(cat "$sysfs"/start) * 512 ))
  echo "$start $(( start + $(cat "$sysfs"/size) * 512 ))"
}

# One line about a partition, for the lists the person chooses from
describe_partition() {
  local size type_name label fs
  size=$(lsblk -ndo SIZE "$1" | tr -d ' ')
  type_name=$(lsblk -ndo PARTTYPENAME "$1")
  label=$(lsblk -ndo PARTLABEL "$1")
  fs=$(lsblk -ndo FSTYPE "$1")
  echo "$1  $size, $type_name, \"$label\"${fs:+, $fs}"
}

esp=""
# Every partition on the disk, ESPs included: what stays in place when a
# system is replaced
partitions=()
# Partitions of the types bunix boots by.  The initrd and systemd-boot take
# the first of each type they find on the disk, so another one -- an older
# bunix, say -- has to go first.
discoverable=()
# Every partition of a Linux type (lsblk names them "Linux ...": root, /usr,
# home, swap, LVM, RAID, LUKS, XBOOTLDR), the discoverable ones included
linux_partitions=()
# The releases an earlier bunix's /usr slots are named after
bunix_releases=()
while read -r name type; do
  [ "$type" = part ] || continue
  partitions+=("$name")
  part_type=$(lsblk -ndo PARTTYPE "$name")
  if [ "$part_type" = "$TYPE_ESP" ]; then
    esp=$name
    continue
  fi
  case $part_type in
    "$TYPE_ROOT"|"$TYPE_XBOOTLDR"|"$TYPE_USR"|"$TYPE_USR_VERITY"|"$TYPE_USR_VERITY_SIG")
      discoverable+=("$name") ;;
  esac
  type_name=$(lsblk -ndo PARTTYPENAME "$name")
  case $type_name in
    Linux*) linux_partitions+=("$name") ;;
  esac
  if [ "$part_type" = "$TYPE_USR" ]; then
    label=$(lsblk -ndo PARTLABEL "$name")
    case $label in
      bunix_*) bunix_releases+=("${label#bunix_}") ;;
    esac
  fi
  read -r start end < <(extent_of "$name")
  places+=("partition $start $end $name replace $(describe_partition "$name")")
done < <(lsblk -nrpo NAME,TYPE "$disk")

# --- earlier systems on it ----------------------------------------------

# A best guess from the partition table alone: no file system is mounted or
# read.  An earlier bunix is the discoverable partitions, when a /usr slot
# is named after a bunix release; other Linux partitions may be one system
# or several.  Offered on GPT disks only, which bunix-install adds its
# partitions to.

# The free stretch, in bytes, that deleting the given partitions leaves.
# Around each of them, free space reaches back to the nearest partition
# that stays before it and on to the nearest one after it; the largest such
# stretch wins.  Prints "start end".
freed_space() {
  local table first_usable end_usable
  table=$(sfdisk -d "$disk")
  first_usable=$(( $(sed -n 's/^first-lba: //p' <<< "$table") * sector_size ))
  end_usable=$(( ($(sed -n 's/^last-lba: //p' <<< "$table") + 1) * sector_size ))

  local best_start=0 best_end=0
  local deleted deleted_start deleted_end kept kept_start kept_end
  for deleted in "$@"; do
    read -r deleted_start deleted_end < <(extent_of "$deleted")
    local gap_start=$first_usable gap_end=$end_usable
    for kept in "${partitions[@]}"; do
      is_one_of "$kept" "$@" && continue
      read -r kept_start kept_end < <(extent_of "$kept")
      if [ "$kept_end" -le "$deleted_start" ] && [ "$kept_end" -gt "$gap_start" ]; then
        gap_start=$kept_end
      fi
      if [ "$kept_start" -ge "$deleted_end" ] && [ "$kept_start" -lt "$gap_end" ]; then
        gap_end=$kept_start
      fi
    done
    if [ $(( gap_end - gap_start )) -gt $(( best_end - best_start )) ]; then
      best_start=$gap_start
      best_end=$gap_end
    fi
  done
  echo "$best_start $best_end"
}

# A choice that replaces an earlier system, with the partitions it deletes:
# "earlier start end p1,p2,... description"
add_earlier_place() {
  local description=$1; shift
  local start end
  read -r start end < <(freed_space "$@")
  local bytes=0 name part_start part_end
  for name in "$@"; do
    read -r part_start part_end < <(extent_of "$name")
    bytes=$(( bytes + part_end - part_start ))
  done
  local joined
  joined=$(printf '%s,' "$@")
  places+=("earlier $start $end ${joined%,} replace $description: $# partitions, $(numfmt --to=iec "$bytes")")
}

has_gpt=no
if [ "$(lsblk -ndo PTTYPE "$disk")" = gpt ]; then
  has_gpt=yes
fi
has_other_linux=no
for name in "${linux_partitions[@]}"; do
  is_one_of "$name" "${discoverable[@]}" || has_other_linux=yes
done
if [ "$has_gpt" = yes ] && [ ${#linux_partitions[@]} -gt 0 ]; then
  if [ ${#bunix_releases[@]} -gt 0 ]; then
    newest_bunix=$(printf '%s\n' "${bunix_releases[@]}" | sort -V | tail -1)
    add_earlier_place "the earlier bunix $newest_bunix" "${discoverable[@]}"
    if [ "$has_other_linux" = yes ]; then
      add_earlier_place "the earlier bunix $newest_bunix and the other Linux partitions" "${linux_partitions[@]}"
    fi
  else
    add_earlier_place "the Linux system" "${linux_partitions[@]}"
  fi
fi

if sfdisk -d "$disk" >/dev/null 2>&1; then
  # sfdisk -F lists free stretches as "start end sectors size", in sectors
  while read -r first last _; do
    [[ "$first" =~ ^[0-9]+$ && "$last" =~ ^[0-9]+$ ]] || continue
    start=$(( first * sector_size ))
    end=$(( (last + 1) * sector_size ))
    places+=("free $start $end - free space ($(( (end - start) / MiB )) MiB)")
  done < <(sfdisk -F "$disk")
fi
places+=("disk 0 $(blockdev --getsize64 "$disk") - the whole disk -- erases everything on it")

# Whether bunix fits into a place: its whole MiB, and an ESP if the place
# brings a new one
fits() {
  local kind=$1 start=$2 end=$3
  local first_mib=$(( (start + MiB - 1) / MiB ))
  local end_mib=$(( end / MiB ))
  local needed=$NEEDED_SIZE
  if [ -z "$esp" ] || [ "$kind" = disk ]; then
    needed=$(( NEEDED_SIZE + ESP_SIZE ))
  fi
  [ $(( end_mib - first_mib )) -ge "$needed" ]
}

echo
echo "On $disk:"
lsblk -o NAME,SIZE,FSTYPE,PARTTYPENAME,PARTLABEL "$disk" | sed 's/^/  /'
echo
echo "Install bunix into (it needs $NEEDED_SIZE MiB, plus $ESP_SIZE MiB if the disk has no ESP):"
for i in "${!places[@]}"; do
  read -r kind start end _ description <<< "${places[$i]}"
  too_small=""
  fits "$kind" "$start" "$end" || too_small="  (too small)"
  printf '  %d) %s%s\n' $((i + 1)) "$description" "$too_small"
done
index=$(ask_number "Which?" ${#places[@]})
read -r kind start end delete_field description <<< "${places[$index]}"
fits "$kind" "$start" "$end" || die "not enough space there"
to_delete=()
if [ "$delete_field" != - ]; then
  read -r -a to_delete <<< "${delete_field//,/ }"
fi
if [ "$kind" != disk ]; then
  for name in "${discoverable[@]}"; do
    is_one_of "$name" "${to_delete[@]}" && continue
    die "$disk already has a root, XBOOTLDR or /usr partition ($name), from an
earlier bunix perhaps; replace it (one of the choices), or install to the
whole disk"
  done
fi
# The live system leaves the disks alone, but the person may have mounted
# one, turned a swap partition on, or unlocked an encrypted one (its
# holder, the mapped device, keeps wipefs out)
for name in "${to_delete[@]}"; do
  in_use=$(lsblk -no MOUNTPOINTS "$name" | tr -d '\n')
  [ -z "$in_use" ] || die "$name is in use ($in_use): unmount it, or turn its swap off, first"
  holders=$(ls /sys/class/block/"$(basename "$name")"/holders | tr '\n' ' ')
  [ -z "$holders" ] || die "$name is open as $holders: close it first (cryptsetup close, dmsetup remove)"
done

# A shared ESP needs room for bunix's few MiB of boot files.  Checked now,
# before anything on the disk changes.  Also read, for the warnings when a
# system is replaced: other systems' boot loaders, and another
# systemd-boot's settings, which bunix's systemd-boot would read too.
esp_other_loaders=""
esp_loader_settings=""
has_loader_conf=no
if [ -n "$esp" ] && [ "$kind" != disk ]; then
  mount "$esp" "$WORK"/esp
  esp_free_mib=$(df --output=avail -B1M "$WORK"/esp | tail -1 | tr -d ' ')
  for dir in "$WORK"/esp/EFI/*/; do
    [ -d "$dir" ] || continue
    dir_name=$(basename "$dir")
    case ${dir_name,,} in boot|microsoft|bunix) continue ;; esac
    esp_other_loaders+="$dir_name "
  done
  if [ -e "$WORK"/esp/loader/loader.conf ]; then
    has_loader_conf=yes
    esp_loader_settings=$(grep -E '^(default|timeout)' "$WORK"/esp/loader/loader.conf | tr '\n' ' ' || true)
  fi
  umount "$WORK"/esp
  [ "$esp_free_mib" -ge 8 ] || die "the ESP ($esp) has only $esp_free_mib MiB free; bunix needs 8"
fi

# --- the system and its user --------------------------------------------

# Asked, and checked, before anything on the disk changes: a failure
# later would leave the disk half installed
echo
echo "Install:"
echo "  1) the desktop: niri with DMS, with a login screen"
echo "  2) the console only: text, no graphics"
systems=(desktop console)
index=$(ask_number "Which?" ${#systems[@]})
system=${systems[$index]}
desktop_image=$files/desktop_$release.raw
if [ "$system" = desktop ] && [ ! -e "$desktop_image" ]; then
  die "the medium has no desktop extension (desktop_$release.raw)"
fi

echo
host_name=$(ask "This computer's name, on the network (like \"sara-laptop\"):")
host_name=${host_name,,}
# One DNS label (hostname(7)): networkd sends it to the DHCP server, whose
# DNS may answer for it.  A letter first, as RFC 952 has it: "1234" would
# be read as an IPv4 address.
valid_host_name='^[a-z]([a-z0-9-]{0,61}[a-z0-9])?$'
[[ "$host_name" =~ $valid_host_name ]] ||
  die "a computer's name is letters, digits and '-', at most 63, starting with a letter and not ending with '-': $host_name"
# systemd takes it for "no name set"
[ "$host_name" != localhost ] || die "\"localhost\" is every computer's name for itself"

echo
echo "Your account.  It can run administrator commands (run0); root itself"
echo "cannot log in."
full_name=$(ask "Your name:")
# (they separate the fields of /etc/passwd and of its name field)
case $full_name in
  *:*|*,*) die "the name cannot contain ':' or ','" ;;
esac

user_name=$(ask "User name (lower case, like \"sara\"):")
valid_user_name='^[a-z_][a-z0-9_-]{0,31}$'
[[ "$user_name" =~ $valid_user_name ]] ||
  die "a user name is lower-case letters, digits, '-' and '_', starting with a letter or '_': $user_name"
# The system's own accounts and groups: the live system has the same ones
# as the installed system, except those of the extensions it has not
# merged -- the desktop's greeter (base/greetd.bst).  useradd also makes a
# group of the user's name, so that name must be free too.
taken=no
getent passwd "$user_name" >/dev/null && taken=yes
getent group "$user_name" >/dev/null && taken=yes
[ "$user_name" = greeter ] && taken=yes
[ "$taken" = no ] || die "\"$user_name\" is one of the system's own names"

password=$(ask_secret "Password:")
[ -n "$password" ] || die "the password is empty"
password_again=$(ask_secret "Password again:")
[ "$password" = "$password_again" ] || die "the passwords differ"

# --- confirm, then clear the place --------------------------------------

case $kind in
  disk)
    confirm=$(ask "ERASE all of $disk? Type the disk's name ($disk) to go on:")
    [ "$confirm" = "$disk" ] || die "cancelled"
    wipefs -q -a "$disk"
    echo 'label: gpt' | sfdisk -q "$disk"
    esp=""
    # the whole disk is now one free stretch
    read -r first last _ < <(sfdisk -F "$disk" | grep -E '^ *[0-9]+ +[0-9]+ ' | head -1)
    start=$(( first * sector_size ))
    end=$(( (last + 1) * sector_size ))
    ;;
  partition)
    confirm=$(ask "DELETE $delete_field and everything on it? Type its name ($delete_field) to go on:")
    [ "$confirm" = "$delete_field" ] || die "cancelled"
    wipefs -q -a "$delete_field"
    sfdisk -q --delete "$disk" "$(cat /sys/class/block/"$(basename "$delete_field")"/partition)"
    ;;
  earlier)
    echo
    echo "These partitions on $disk are DELETED, with everything on them:"
    for name in "${to_delete[@]}"; do
      echo "  $(describe_partition "$name")"
    done
    echo
    echo "Check this list.  It is a guess from the partition table: bunix-install"
    echo "goes by the partitions' types and names and does not look inside them."
    echo "  - Your files on them are lost, /home included.  Back them up first."
    for name in "${to_delete[@]}"; do
      case $(lsblk -ndo FSTYPE "$name") in
        crypto_LUKS) echo "  - $name is encrypted: what is in it cannot be seen." ;;
        LVM2_member) echo "  - $name holds LVM volumes; a volume group can reach over other"
                     echo "    disks, whose volumes then stop working too." ;;
        linux_raid_member) echo "  - $name is part of a RAID array, which may reach over other disks." ;;
      esac
    done
    for name in "${to_delete[@]}"; do
      read -r part_start _ < <(extent_of "$name")
      is_inside=no
      if [ "$part_start" -ge "$start" ] && [ "$part_start" -lt "$end" ]; then
        is_inside=yes
      fi
      [ "$is_inside" = yes ] && continue
      echo "  - $name is elsewhere on the disk: bunix goes into the largest freed"
      echo "    stretch ($(( (end - start) / MiB )) MiB), and $name's space stays free."
    done
    if [ "$has_loader_conf" = yes ]; then
      echo "  - The ESP has systemd-boot settings (loader/loader.conf:"
      echo "    ${esp_loader_settings:-no default}), which may start the old system."
      echo "    They are kept as loader/loader.conf.before-bunix, and bunix's, with"
      echo "    bunix as the default, take their place."
    fi
    if [ -e "$LOADER_ENTRY_DEFAULT_VAR" ]; then
      echo "  - A default boot entry set with 'bootctl set-default' is removed."
    fi
    if [ -n "$esp_other_loaders" ]; then
      echo "  - The ESP ($esp) stays, and so do other systems' boot files in it"
      echo "    (EFI/: $esp_other_loaders) and their firmware boot entries, which"
      echo "    may then start nothing, or be what the firmware starts first.  Remove"
      echo "    them yourself if they are the old system's (efibootmgr -b <entry> -B)."
    fi
    echo
    confirm=$(ask "DELETE these ${#to_delete[@]} partitions? Type the disk's name ($disk) to go on:")
    [ "$confirm" = "$disk" ] || die "cancelled"
    # the numbers first: a partition wiped and then found busy would stop
    # the script with the table unchanged
    numbers=()
    for name in "${to_delete[@]}"; do
      numbers+=("$(cat /sys/class/block/"$(basename "$name")"/partition)")
    done
    for name in "${to_delete[@]}"; do
      wipefs -q -a "$name"
    done
    sfdisk -q --delete "$disk" "${numbers[@]}"
    ;;
  free)
    confirm=$(ask "Install into this free space? [yes/no]")
    [ "$confirm" = yes ] || die "cancelled"
    ;;
esac

# --- partitions ---------------------------------------------------------

# Laid out one after another from the start of the place, in whole MiB;
# root takes what is left.  sfdisk gets each partition's exact position,
# so nothing lands in some other free stretch of the disk.
position=$(( (start + MiB - 1) / MiB ))
place_end=$(( end / MiB ))
script=""
add_partition() {
  local size=$1 type=$2 name=$3 uuid=$4 attributes=${5:-}
  local line="start=${position}MiB, type=$type, name=\"$name\", uuid=$uuid"
  [ "$size" = rest ] || line="$line, size=${size}MiB"
  [ -z "$attributes" ] || line="$line, attrs=\"$attributes\""
  script+="$line"$'\n'
  [ "$size" = rest ] || position=$(( position + size ))
}

new_esp=no
if [ -z "$esp" ]; then
  new_esp=yes
  esp_uuid=$(new_uuid)
  add_partition $ESP_SIZE $TYPE_ESP "ESP" "$esp_uuid"
fi
boot_uuid=$(new_uuid)
root_uuid=$(new_uuid)
add_partition $BOOT_SIZE $TYPE_XBOOTLDR "XBOOTLDR" "$boot_uuid"
# Slot A: read-only (GPT attribute 60), as system/disk.bst makes it
add_partition $USR_SIZE $TYPE_USR "bunix_$release" "$(uuid_in_name "$usr_image")" GUID:60
add_partition $USR_VERITY_SIZE $TYPE_USR_VERITY "bunix_${release}_verity" "$(uuid_in_name "$verity_image")" GUID:60
add_partition $USR_SIGNATURE_SIZE $TYPE_USR_VERITY_SIG "bunix_${release}_verity_sig" "$(uuid_in_name "$signature_image")" GUID:60
# Slot B: "_empty" is where sysupdate writes the next release
add_partition $USR_SIZE $TYPE_USR "_empty" "$(new_uuid)"
add_partition $USR_VERITY_SIZE $TYPE_USR_VERITY "_empty" "$(new_uuid)"
add_partition $USR_SIGNATURE_SIZE $TYPE_USR_VERITY_SIG "_empty" "$(new_uuid)"
root_size=$(( place_end - position ))
[ "$root_size" -ge "$ROOT_MIN_SIZE" ] || die "not enough space: root would get $root_size MiB, it needs $ROOT_MIN_SIZE"
add_partition rest $TYPE_ROOT "root" "$root_uuid"

echo "Creating partitions..."
printf '%s' "$script" | sfdisk -q --append "$disk"
udevadm settle

echo "Writing /usr ($release)..."
dd if="$usr_image" of="$(device_of_partuuid "$(uuid_in_name "$usr_image")")" bs=4M conv=fsync status=none
dd if="$verity_image" of="$(device_of_partuuid "$(uuid_in_name "$verity_image")")" bs=4M conv=fsync status=none
dd if="$signature_image" of="$(device_of_partuuid "$(uuid_in_name "$signature_image")")" bs=4M conv=fsync status=none

echo "Writing the boot files..."
boot=$(device_of_partuuid "$boot_uuid")
mkfs.vfat -F 32 -n BUNIX_BOOT "$boot" >/dev/null
mount "$boot" "$WORK"/boot
mkdir -p "$WORK"/boot/EFI/Linux
cp "$uki" "$WORK"/boot/EFI/Linux/

esp_files=$files/esp
if [ "$new_esp" = yes ]; then
  esp=$(device_of_partuuid "$esp_uuid")
  mkfs.vfat -F 32 -n ESP "$esp" >/dev/null
  mount "$esp" "$WORK"/esp
  # bunix's own ESP: the default loader too, so the disk also boots where
  # it has no boot entry
  cp -r "$esp_files"/. "$WORK"/esp/
else
  mount "$esp" "$WORK"/esp
  # A shared ESP: only bunix's directory.  EFI/BOOT/ is Windows' fallback,
  # and an existing loader.conf belongs to another systemd-boot.
  rm -rf "$WORK"/esp/EFI/bunix
  mkdir -p "$WORK"/esp/EFI "$WORK"/esp/loader
  cp -r "$esp_files"/EFI/bunix "$WORK"/esp/EFI/
  loader_conf=$WORK/esp/loader/loader.conf
  if [ "$kind" = earlier ]; then
    # A replaced system's systemd-boot settings, or its entries, which sort
    # before bunix's, would start the old system: bunix's settings take
    # their place, with bunix's kernel images as the default (the
    # confirmation said so)
    if [ -e "$loader_conf" ]; then
      mv "$loader_conf" "$loader_conf".before-bunix
    fi
    { cat "$esp_files"/loader/loader.conf; echo 'default bunix_*'; } > "$loader_conf"
    if [ -e "$LOADER_ENTRY_DEFAULT_VAR" ]; then
      bootctl set-default ''
    fi
  elif [ ! -e "$loader_conf" ]; then
    cp "$esp_files"/loader/loader.conf "$loader_conf"
  fi
fi

echo "Creating the root file system..."
mkfs.ext4 -q -F "$(device_of_partuuid "$root_uuid")"
mount "$(device_of_partuuid "$root_uuid")" "$WORK"/root
# What systemd-repart would make of a new root (usr/lib/repart.d/50-root.conf):
# the mount points, and the merged-/usr links at the top (UAPI.9)
mkdir -p "$WORK"/root/usr "$WORK"/root/etc "$WORK"/root/var "$WORK"/root/home \
         "$WORK"/root/root "$WORK"/root/srv "$WORK"/root/tmp
ln -s usr/bin "$WORK"/root/bin
ln -s usr/bin "$WORK"/root/sbin
ln -s usr/lib "$WORK"/root/lib
ln -s usr/lib/x86_64-linux-gnu "$WORK"/root/lib64

# --- the system and its user, on the new root ---------------------------

# Before the first boot, whose tmpfiles copy the factory name ("bunix")
# only when /etc/hostname is missing
echo "$host_name" > "$WORK"/root/etc/hostname

echo "Creating your account..."
# The system's own accounts first, so that wheel exists to join: made as
# the first boot would make them, from /usr's sysusers.d.  The new root
# has no /usr of its own (that is the verity partition, mounted at boot),
# so they come from the live system's, the same release's.  (Warnings
# only: it would list every account it makes.)
cat /usr/lib/sysusers.d/*.conf | SYSTEMD_LOG_LEVEL=warning systemd-sysusers --root="$WORK"/root -
# useradd's defaults (the id range, the password hash, the shell), which
# the first boot would copy too
mkdir -p "$WORK"/root/etc/default
cp /usr/share/factory/etc/login.defs "$WORK"/root/etc/
cp /usr/share/factory/etc/default/useradd "$WORK"/root/etc/default/
useradd --prefix "$WORK"/root --create-home --comment "$full_name" --groups wheel "$user_name"
printf '%s:%s\n' "$user_name" "$password" | chpasswd --prefix "$WORK"/root
# Root: a random password, locked.  Without a hash console-shell would take
# root for a machine nobody has set up yet and open its shell.
printf 'root:%s\n' "$(head -c 32 /dev/urandom | base64)" | chpasswd --prefix "$WORK"/root
usermod --prefix "$WORK"/root --lock root

if [ "$system" = desktop ]; then
  echo "Adding the desktop..."
  # Where sysupdate keeps the extension's versions, and its feature turned
  # on, so updates bring the next ones (/usr/lib/sysupdate.d/desktop.feature,
  # 54-desktop.transfer)
  mkdir -p "$WORK"/root/var/lib/extensions/desktop.raw.v "$WORK"/root/etc/sysupdate.d/desktop.feature.d
  cp "$desktop_image" "$WORK"/root/var/lib/extensions/desktop.raw.v/
  printf '[Feature]\nEnabled=true\n' > "$WORK"/root/etc/sysupdate.d/desktop.feature.d/enable.conf
fi
sync

# --- the firmware boot entry --------------------------------------------

echo "Adding the firmware boot entry..."
esp_disk=/dev/$(lsblk -ndo PKNAME "$esp")
esp_number=$(cat /sys/class/block/"$(basename "$esp")"/partition)
esp_partuuid=$(lsblk -ndo PARTUUID "$esp")
# The numbers of the "bunix" entries on this ESP.  efibootmgr -v lines look
# like "Boot0004* bunix<tab>HD(1,GPT,<partuuid>,...)/\EFI\bunix\shimx64.efi..."
bunix_entries_on_esp() {
  local entries
  entries=$(efibootmgr -v)
  grep -i "$esp_partuuid" <<< "$entries" | grep -E $'^Boot[0-9A-F]{4}\\* bunix\t' | cut -c5-8 || true
}

# A reinstall replaces the entry for this ESP; entries for other disks stay
for entry in $(bunix_entries_on_esp); do
  efibootmgr -q -b "$entry" -B
done
boot_order=$(efibootmgr | sed -n 's/^BootOrder: //p')
# shim, told which loader to start: its load options name systemd-boot
efibootmgr -q --create --disk "$esp_disk" --part "$esp_number" --label bunix \
  --loader '\EFI\bunix\shimx64.efi' --unicode '\EFI\bunix\systemd-bootx64.efi'
bunix_entry=$(bunix_entries_on_esp | head -1)
[ -n "$bunix_entry" ] || die "efibootmgr did not create the boot entry"

# efibootmgr puts the new entry first.  Windows stays the default when it
# is there: bunix goes last.
has_windows=no
if efibootmgr | grep -q 'Windows Boot Manager'; then
  has_windows=yes
fi
if [ "$has_windows" = yes ]; then
  efibootmgr -q --bootorder "${boot_order:+$boot_order,}$bunix_entry"
fi

# What the firmware starts first now: Windows, or, after a replaced Linux,
# perhaps that system's own entry
first_entry=$(efibootmgr | sed -n 's/^BootOrder: \([0-9A-F]\{4\}\).*/\1/p')
first_label=$(efibootmgr | sed -n "s/^Boot$first_entry\*\{0,1\} //p" | cut -f1)

# --- done ---------------------------------------------------------------

echo
echo "bunix $release is installed on $disk (boot entry Boot$bunix_entry)."
echo "Log in as \"$user_name\"."
if [ "$first_entry" != "$bunix_entry" ]; then
  echo "The firmware starts \"$first_label\" first: to start bunix, choose"
  echo "\"bunix\" in its boot menu (a key like F12, F11 or Esc at power-on)."
fi
if [ "$has_windows" = yes ]; then
  echo "Windows keeps the hardware clock in local time, bunix in UTC; to"
  echo "make them agree, run 'timedatectl set-local-rtc 1' in bunix."
fi
# The variable: 4 bytes of attributes, then 1 when Secure Boot is on.
# Firmware without Secure Boot has no such variable.
# Read through a pipe: efivarfs files report a size of 0, and od cannot
# skip into a file it thinks is empty.
secure_boot=0
if [ -e "$SECURE_BOOT_VAR" ]; then
  secure_boot=$(head -c 5 "$SECURE_BOOT_VAR" | tail -c 1 | od -An -tu1 | tr -d ' ')
fi
if [ "$secure_boot" = 1 ]; then
  echo "Secure Boot is on: the first boot stops in MokManager.  Choose"
  echo "\"Enroll key from disk\", then EFI/bunix/bunix.cer on the ESP."
fi
