# bunix: how a password is checked and stored, for every program that asks
# (login, greetd, run0).  Passwords live in /etc/shadow; new ones are hashed
# with yescrypt (libxcrypt's strongest).  Read after /etc/pam.d/system-auth,
# which overrides this file when it exists.
auth      required  pam_faildelay.so delay=2000000
auth      required  pam_unix.so
account   required  pam_unix.so
password  required  pam_unix.so yescrypt shadow
session   required  pam_limits.so
session   required  pam_unix.so
