#!/bin/bash
# Opens sshd's ports in the firewall while sshd runs (sshd.service):
#   sshd-firewall open    the ports sshd's configuration listens on
#   sshd-firewall close
# The firewall is reloaded only if it is running.
set -euo pipefail

rules=/run/nftables.d/sshd.nft

if [ "${1:-}" = open ]; then
  mkdir -p /run/nftables.d
  # sshd -T prints the effective settings, "Port 22" ("port 22" before OpenSSH 10)
  /usr/bin/sshd -T | sed -n 's/^[Pp]ort \([0-9]*\)$/tcp dport \1 accept/p' > "$rules"
else
  rm -f "$rules"
fi
systemctl --no-block try-reload-or-restart nftables.service
