#!/bin/sh
# The console (console-shell@.service): root's shell straight away while
# root has never had a password -- the live ISO, or a fresh disk image,
# where nobody could log in otherwise (bunix-install locks root's password
# and makes an account) -- and a login prompt in every other case.
# "Never had one": the field holds no hash at all ('', '*', '!*', or
# sysusers' '!unprovisioned').  A locked password ('!' before a hash,
# `passwd -l root`) means "no logins as root" and gets the login prompt,
# as does an unreadable /etc/shadow.
[ -r /etc/shadow ] || exec /usr/bin/login
root_password=$(awk -F: '$1 == "root" { print $2 }' /etc/shadow)
case $root_password in
  *'$'*) exec /usr/bin/login ;;
esac
exec /usr/bin/fish --login
