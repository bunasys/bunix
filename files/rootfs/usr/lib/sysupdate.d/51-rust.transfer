# The rust extension (rust.feature), built with each release and updated
# in lock-step with /usr, like the gcc extension (50-gcc.transfer, which
# explains the details).  It needs the gcc extension merged too.
[Transfer]
Features=rust
ProtectVersion=%A

[Source]
Type=url-file
Path=https://github.com/bunasys/bunix/releases/latest/download/
MatchPattern=rust_@v.raw

[Target]
Type=regular-file
Path=/var/lib/extensions/rust.raw.v
MatchPattern=rust_@v.raw
Mode=0444
InstancesMax=2
