# The desktop extension (desktop.feature), built with each release and
# updated in lock-step with /usr, as 50-gcc.transfer explains.  It needs no
# other extension.
[Transfer]
Features=desktop
ProtectVersion=%A

[Source]
Type=url-file
Path=https://github.com/bunasys/bunix/releases/latest/download/
MatchPattern=desktop_@v.raw

[Target]
Type=regular-file
Path=/var/lib/extensions/desktop.raw.v
MatchPattern=desktop_@v.raw
Mode=0444
InstancesMax=2
